---
import { Image } from 'astro:assets';
import { navLinks } from '../data/site';
import logoLight from '../assets/img/logo-light.png';
// 公安备案徽标（警徽）。原图同款由公安部经备案平台核发，本副本取自公开 CDN；
// 官方直发地址需登录 beian.mps.gov.cn 下载，故此处使用等效副本。
import ghIcon from '../assets/img/gh.png';
---

<!-- 页脚（深色） -->
<footer class="border-t border-white/[0.08] bg-brand-deep py-12">
  <div class="mx-auto flex max-w-300 flex-wrap items-start justify-between gap-6 px-6 lg:px-10">
    <div>
      <div class="flex items-center">
        <Image
          src={logoLight}
          alt="百六智数字科技"
          width={255}
          widths={[255, 510]}
          sizes="255px"
          format="png"
          class="block h-[30px] w-auto"
        />
      </div>
      <p class="mt-1 mb-0 text-[0.875rem] text-[#dee7ff]/66">
        © 2026 百六智数字科技 · 让每一家追求卓越的制造企业，都拥有专属「智慧大脑」
      </p>
    </div>
    <nav class="flex flex-wrap gap-6 pt-1.5" aria-label="页脚导航">
      {
        navLinks.map((link) => (
          <a
            class="inline-flex items-center gap-1.5 text-[0.9rem] text-[#dee7ff]/72 transition-colors hover:text-gold"
            href={link.href}
          >
            {link.label}
            {('deprecated' in link) && link.deprecated && (
              <span class="inline-block rounded-sm bg-white/10 px-1.5 py-0.5 text-[0.65rem] font-normal text-[#dee7ff]/60">
                {link.deprecated}
              </span>
            )}
          </a>
        ))
      }
      <a
        class="text-[0.9rem] text-[#dee7ff]/72 transition-colors hover:text-gold"
        href="/#contact"
      >
        联系我们
      </a>
    </nav>
    <div class="mt-4 flex w-full flex-wrap items-center gap-x-3 gap-y-1 text-[0.8rem] text-[#dee7ff]/50">
      <a
        class="transition-colors hover:text-gold"
        href="https://beian.miit.gov.cn/"
        rel="nofollow noopener"
        target="_blank"
      >
          苏ICP备2026067886号
      </a>
      <a
        class="inline-flex items-center gap-1 transition-colors hover:text-gold"
        href="https://beian.mps.gov.cn/#/query/webSearch?code=32021102003710"
        rel="nofollow noopener"
        target="_blank"
      >
        <Image
          src={ghIcon}
          alt="公安备案"
          width={14}
          height={14}
          densities={[1, 2]}
          loading="lazy"
          decoding="async"
          class="block h-[14px] w-[14px]"
        />
          苏公网安备32021102003710号
      </a>
    </div>
  </div>
</footer>
