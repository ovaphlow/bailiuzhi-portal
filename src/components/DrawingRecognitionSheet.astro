---
/**
 * 二维图纸智能识别「可识别标注类型」示意（纯 SVG 绘制，不使用 PPT 配图）。
 * 左侧为示意图纸（零件轮廓、尺寸公差、形位公差、表面结构、技术要求、明细表、气泡号），
 * 右侧为可识别的标注类型清单，取自《二维图纸自动识别软件介绍1.0.pptx》slide5。
 */
const C = {
  deep: '#0f2e63',
  brand: '#1d4ed8',
  gold: '#d4af37',
  goldDeep: '#b8860b',
  ink: '#0f172a',
  muted: '#64748b',
  line: '#cbd5e1',
  faint: '#e2e8f0',
  bar: '#cbd5e1',
};

/** 图例：可识别的标注类型 */
const legend = [
  { name: '尺寸公差', glyph: 'dim' },
  { name: '形位公差', glyph: 'gdt' },
  { name: '表面结构', glyph: 'rough' },
  { name: '技术要求与明细表', glyph: 'note' },
  { name: '标注线 / 箭头', glyph: 'leader' },
  { name: '零件轮廓', glyph: 'contour' },
  { name: '气泡号、基准', glyph: 'balloon' },
];

const LX = 800; // 图例左边界
const LG = 826; // 图例图形中心 x
const ROW0 = 82;
const ROW_H = 46;
const rowY = (i: number) => ROW0 + i * ROW_H;
---

<div class="-mx-6 overflow-x-auto px-6 pb-1 lg:mx-0 lg:overflow-visible lg:px-0">
  <svg
    viewBox="0 0 1160 460"
    role="img"
    aria-label="二维图纸智能识别示意：可识别尺寸公差、形位公差、表面结构、技术要求与明细表、标注线与箭头、零件轮廓、气泡号与基准，并支持图纸分割与连续性重构。"
    class="block h-auto w-full min-w-[880px]"
  >
    <title>可识别的标注类型</title>

    <!-- 图纸 -->
    <rect x={20} y={20} width={740} height={420} rx={10} fill="#ffffff" stroke={C.line} />

    <!-- 明细表 -->
    <text x={560} y={32} font-size="11" fill={C.muted}>明细表</text>
    <rect x={560} y={40} width={180} height={56} fill="#ffffff" stroke={C.line} />
    <line x1={560} y1={68} x2={740} y2={68} stroke={C.line} />
    <line x1={560} y1={96} x2={740} y2={96} stroke={C.line} />
    <line x1={616} y1={40} x2={616} y2={96} stroke={C.line} />
    <g fill={C.bar}>
      <rect x={570} y={50} width={36} height={6} rx={3} />
      <rect x={626} y={50} width={70} height={6} rx={3} />
      <rect x={570} y={78} width={36} height={6} rx={3} />
      <rect x={626} y={78} width={54} height={6} rx={3} />
    </g>

    <!-- 形位公差框 -->
    <rect x={140} y={96} width={130} height={26} fill="#ffffff" stroke={C.goldDeep} stroke-width="1.5" />
    <line x1={176} y1={96} x2={176} y2={122} stroke={C.goldDeep} stroke-width="1.5" />
    <line x1={228} y1={96} x2={228} y2={122} stroke={C.goldDeep} stroke-width="1.5" />
    <text x={158} y={114} text-anchor="middle" font-size="12" fill={C.goldDeep}>⌖</text>
    <text x={202} y={114} text-anchor="middle" font-size="12" fill={C.goldDeep}>⌀0.02</text>
    <text x={247} y={114} text-anchor="middle" font-size="12" fill={C.goldDeep}>A</text>
    <line x1={205} y1={122} x2={205} y2={130} stroke={C.goldDeep} stroke-width="1.2" />

    <!-- 零件轮廓 -->
    <rect x={140} y={130} width={380} height={180} rx={6} fill="none" stroke={C.ink} stroke-width="2.5" />
    <rect x={300} y={200} width={60} height={40} rx={18} fill="none" stroke={C.ink} stroke-width="2" />
    <g fill="none" stroke={C.ink} stroke-width="2">
      <circle cx={180} cy={170} r={12} />
      <circle cx={480} cy={170} r={12} />
      <circle cx={180} cy={270} r={12} />
      <circle cx={480} cy={270} r={12} />
    </g>

    <!-- 尺寸公差：横向 -->
    <g stroke={C.goldDeep} stroke-width="1.2">
      <line x1={140} y1={310} x2={140} y2={348} />
      <line x1={520} y1={310} x2={520} y2={348} />
      <line x1={146} y1={340} x2={514} y2={340} />
    </g>
    <polygon points="146,336 134,340 146,344" fill={C.goldDeep} />
    <polygon points="514,336 526,340 514,344" fill={C.goldDeep} />
    <text x={330} y={366} text-anchor="middle" font-size="12.5" font-weight="600" fill={C.goldDeep}>380 ±0.05</text>

    <!-- 尺寸公差：纵向 -->
    <g stroke={C.goldDeep} stroke-width="1.2">
      <line x1={140} y1={130} x2={98} y2={130} />
      <line x1={140} y1={310} x2={98} y2={310} />
      <line x1={104} y1={136} x2={104} y2={304} />
    </g>
    <polygon points="100,136 104,124 108,136" fill={C.goldDeep} />
    <polygon points="100,304 104,316 108,304" fill={C.goldDeep} />
    <text x={92} y={224} text-anchor="end" font-size="12.5" font-weight="600" fill={C.goldDeep}>180</text>

    <!-- 表面结构 -->
    <g stroke={C.goldDeep} stroke-width="1.5" fill="none">
      <path d="M549 214 L557 194 L565 214" />
      <line x1={557} y1={194} x2={577} y2={194} />
    </g>
    <text x={584} y={212} font-size="12.5" font-weight="600" fill={C.goldDeep}>Ra 3.2</text>

    <!-- 气泡号 -->
    <g>
      <circle cx={125} cy={110} r={9} fill={C.gold} />
      <text x={125} y={114} text-anchor="middle" font-size="10.5" font-weight="700" fill="#ffffff">1</text>
      <line x1={132} y1={118} x2={142} y2={128} stroke={C.gold} stroke-width="1.2" />
      <circle cx={545} cy={110} r={9} fill={C.gold} />
      <text x={545} y={114} text-anchor="middle" font-size="10.5" font-weight="700" fill="#ffffff">2</text>
      <line x1={538} y1={118} x2={522} y2={128} stroke={C.gold} stroke-width="1.2" />
      <circle cx={270} cy={330} r={9} fill={C.gold} />
      <text x={270} y={334} text-anchor="middle" font-size="10.5" font-weight="700" fill="#ffffff">3</text>
      <line x1={275} y1={322} x2={318} y2={244} stroke={C.gold} stroke-width="1.2" />
    </g>

    <!-- 技术要求 -->
    <text x={140} y={372} font-size="11" fill={C.muted}>技术要求</text>
    <g fill={C.bar}>
      <rect x={140} y={382} width={130} height={5} rx={2.5} />
      <rect x={140} y={394} width={96} height={5} rx={2.5} />
      <rect x={140} y={406} width={112} height={5} rx={2.5} />
    </g>

    <!-- 标题栏 -->
    <rect x={600} y={390} width={150} height={40} fill="#ffffff" stroke={C.line} />
    <line x1={600} y1={410} x2={750} y2={410} stroke={C.line} />
    <g fill={C.bar}>
      <rect x={610} y={398} width={50} height={5} rx={2.5} />
      <rect x={610} y={418} width={80} height={5} rx={2.5} />
    </g>

    <!-- 图例 -->
    <text x={LX} y={48} font-size="14" font-weight="600" fill={C.deep}>可识别的标注类型</text>
    {
      legend.map((l, i) => {
        const y = rowY(i);
        return (
          <g>
            {l.glyph === 'dim' && (
              <g stroke={C.goldDeep} stroke-width="1.3">
                <line x1={LG - 13} y1={y} x2={LG + 13} y2={y} />
                <line x1={LG - 13} y1={y - 7} x2={LG - 13} y2={y + 7} />
                <line x1={LG + 13} y1={y - 7} x2={LG + 13} y2={y + 7} />
              </g>
            )}
            {l.glyph === 'gdt' && (
              <g stroke={C.goldDeep} stroke-width="1.3" fill="none">
                <rect x={LG - 13} y={y - 9} width={26} height={18} />
                <line x1={LG - 4} y1={y - 9} x2={LG - 4} y2={y + 9} />
                <line x1={LG + 5} y1={y - 9} x2={LG + 5} y2={y + 9} />
              </g>
            )}
            {l.glyph === 'rough' && (
              <g stroke={C.goldDeep} stroke-width="1.3" fill="none">
                <path d={`M${LG - 10} ${y + 8} L${LG - 2} ${y - 8} L${LG + 6} ${y + 8}`} />
                <line x1={LG - 2} y1={y - 8} x2={LG + 13} y2={y - 8} />
              </g>
            )}
            {l.glyph === 'note' && (
              <g fill={C.bar}>
                <rect x={LG - 13} y={y - 8} width={26} height={4} rx={2} />
                <rect x={LG - 13} y={y - 2} width={18} height={4} rx={2} />
                <rect x={LG - 13} y={y + 4} width={22} height={4} rx={2} />
              </g>
            )}
            {l.glyph === 'leader' && (
              <g stroke={C.goldDeep} stroke-width="1.3">
                <line x1={LG - 13} y1={y + 6} x2={LG + 13} y2={y - 6} />
                <polygon points={`${LG + 13},${y - 10} ${LG + 7},${y - 6} ${LG + 11},${y - 2}`} fill={C.goldDeep} stroke="none" />
              </g>
            )}
            {l.glyph === 'contour' && (
              <rect x={LG - 13} y={y - 9} width={26} height={18} rx={3} fill="none" stroke={C.ink} stroke-width="1.8" />
            )}
            {l.glyph === 'balloon' && (
              <g>
                <circle cx={LG} cy={y} r={8} fill={C.gold} />
                <text x={LG} y={y + 3.5} text-anchor="middle" font-size="9.5" font-weight="700" fill="#ffffff">1</text>
              </g>
            )}
            <text x={LX + 52} y={y + 5} font-size="13" fill={C.deep}>{l.name}</text>
          </g>
        );
      })
    }
    <text x={LX} y={416} font-size="12" fill={C.muted}>支持图纸分割与连续性重构，</text>
    <text x={LX} y={434} font-size="12" fill={C.muted}>超大幅图纸亦可识别。</text>
  </svg>
</div>
