---
/**
 * 机器视觉光源案例「产品系列库」示意（纯 SVG 绘制，作为 Card 插槽内容）。
 * 系列名称取自该案例软件截图中的「产品系列」树。
 * 不含外框：外框由所在 Card 提供，以便与同排卡片的边框、内边距完全对齐。
 */
const C = {
  brand: '#1d4ed8',
  soft: '#eff4ff',
  muted: '#64748b',
  line: '#e2e8f0',
};

const series = [
  { name: '环形光源系列', glyph: 'ring' },
  { name: '条形光源系列', glyph: 'bar' },
  { name: '同轴光源系列', glyph: 'coaxial' },
  { name: '背光光源系列', glyph: 'backlight' },
  { name: '无影光源系列', glyph: 'dome' },
  { name: '点、线光源系列', glyph: 'dotline' },
];

// 3 列 × 2 行；viewBox 520 × 250
const CW = 162;
const CH = 116;
const CX = (i: number) => (i % 3) * 179;
const CY = (i: number) => Math.floor(i / 3) * 134;
const GX = (i: number) => CX(i) + CW / 2;
const GY = (i: number) => CY(i) + 46;
---

<svg
  viewBox="0 0 520 250"
  role="img"
  aria-label="产品系列库：环形、条形、同轴、背光、无影、点线光源等系列统一入库管理。"
  class="mt-5 block h-auto w-full"
>
  <title>产品系列库</title>
  {
    series.map((s, i) => (
      <g>
        <rect x={CX(i)} y={CY(i)} width={CW} height={CH} rx={10} fill="#ffffff" stroke={C.line} />
        {s.glyph === 'ring' && (
          <g stroke={C.brand} fill="none">
            <circle cx={GX(i)} cy={GY(i)} r={17} stroke-width="2.5" />
            <circle cx={GX(i)} cy={GY(i)} r={8} stroke-width="2" />
          </g>
        )}
        {s.glyph === 'bar' && (
          <rect x={GX(i) - 24} y={GY(i) - 7} width={48} height={15} rx={3} stroke={C.brand} stroke-width="2.5" fill="none" />
        )}
        {s.glyph === 'coaxial' && (
          <g stroke={C.brand} stroke-width="2.5" fill="none">
            <rect x={GX(i) - 17} y={GY(i) - 17} width={34} height={34} rx={3} />
            <circle cx={GX(i)} cy={GY(i)} r={8} stroke-width="2" />
            <line x1={GX(i) + 17} y1={GY(i)} x2={GX(i) + 27} y2={GY(i)} />
          </g>
        )}
        {s.glyph === 'backlight' && (
          <g stroke={C.brand} stroke-width="2.5">
            <rect x={GX(i) - 21} y={GY(i) - 14} width={42} height={28} rx={2} fill="none" />
            <rect x={GX(i) - 13} y={GY(i) - 7} width={26} height={14} fill={C.soft} stroke-width="1.5" />
          </g>
        )}
        {s.glyph === 'dome' && (
          <g stroke={C.brand} stroke-width="2.5" fill="none">
            <path d={`M${GX(i) - 19} ${GY(i) + 9} A19 19 0 0 1 ${GX(i) + 19} ${GY(i) + 9}`} />
            <line x1={GX(i) - 24} y1={GY(i) + 9} x2={GX(i) + 24} y2={GY(i) + 9} />
          </g>
        )}
        {s.glyph === 'dotline' && (
          <g>
            <circle cx={GX(i) - 13} cy={GY(i)} r={5} fill={C.brand} />
            <line x1={GX(i) + 2} y1={GY(i)} x2={GX(i) + 23} y2={GY(i)} stroke={C.brand} stroke-width="2.5" />
          </g>
        )}
        <text x={GX(i)} y={CY(i) + 92} text-anchor="middle" font-size="12.5" fill={C.muted}>
          {s.name}
        </text>
      </g>
    ))
  }
</svg>
