---
/**
 * PPT「轴承行业案例-参数化建模与自动标注自动出图」第 2 页版式复刻。
 *
 * 所有坐标、尺寸、字号直接取自 pptx 形状几何，因此与原始页面一一对应：
 *   - 画布 13.333 × 7.5 in（16:9），即 960 × 540 pt
 *   - 位置用 %（相对画布），字号/线宽用 cqw（随画布宽度等比缩放）
 * 连线为原稿的 11 条流程线（#0070C0，2.25pt，无箭头；其中 1 条虚线、1 条渐变）
 * 与 9 个节点圆点，它们是原页面「数据接口 → 墨·CAS/TAV/DAG → 六项输出」的连接关系。
 */
const M =
  '/assets/media/review/%E8%BD%B4%E6%89%BF%E8%A1%8C%E4%B8%9A%E6%A1%88%E4%BE%8B-%E5%8F%82%E6%95%B0%E5%8C%96%E5%BB%BA%E6%A8%A1%E4%B8%8E%E8%87%AA%E5%8A%A8%E6%A0%87%E6%B3%A8%E8%87%AA%E5%8A%A8%E5%87%BA%E5%9B%BE';

const SW = 13.333;
const SH = 7.5;
const PT = 960; // 画布宽度对应 960pt

const X = (v: number) => `${((v / SW) * 100).toFixed(3)}%`;
const Y = (v: number) => `${((v / SH) * 100).toFixed(3)}%`;
const FS = (pt: number) => `${((pt / PT) * 100).toFixed(3)}cqw`;
/** 形状外框 → 绝对定位样式（结尾保留分号，便于拼接后续声明） */
const box = (o: { x: number; y: number; w: number; h: number }) =>
  `left:${X(o.x)};top:${Y(o.y)};width:${X(o.w)};height:${Y(o.h)};`;

/** 流程线：w>h 视为水平，h>w 视为垂直（原稿线宽 2.25pt） */
const lines = [
  // 原稿此线起于 x=3.723，伸入左侧图片内被遮挡，其可见部分因此越过节点圆点 0.054in。
  // 改为起于该图片右缘 3.91，让圆点正好封住线端（与其余 8 个节点的衔接方式一致）。
  { x: 3.91, y: 2.29, w: 1.577, h: 0 },
  { x: 5.559, y: 2.37, w: 0, h: 1.896 },
  { x: 4.134, y: 5.235, w: 1.09, h: 0 },
  { x: 5.294, y: 4.25, w: 1.102, h: 0.005 },
  { x: 5.224, y: 4.316, w: 0.009, h: 1.752 },
  { x: 5.233, y: 6.068, w: 2.429, h: 0.012 },
  { x: 2.432, y: 5.807, w: 1.102, h: 0.005, gradient: true },
  { x: 9.693, y: 2.518, w: 0.83, h: 0 },
  { x: 9.687, y: 2.528, w: 0.007, h: 2.776 },
  { x: 9.73, y: 4.701, w: 0.926, h: 0, dash: true },
  { x: 10.051, y: 5.807, w: 0.684, h: 0 },
].map((l) => {
  const horiz = l.w >= l.h;
  return {
    ...l,
    style: horiz
      ? `left:${X(l.x)};top:${Y(l.y + l.h / 2)};width:${X(l.w)};height:${FS(2.25)}`
      : `left:${X(l.x + l.w / 2)};top:${Y(l.y)};width:${FS(2.25)};height:${Y(l.h)}`,
  };
});

/** 节点圆点（原稿 0.123in 渐变圆）；首项左移 0.054in 贴住左侧图片右缘，避免线端露出圆点 */
const dots = [
  { x: 3.91, y: 2.229 },
  { x: 5.487, y: 2.229 },
  { x: 5.172, y: 4.193 },
  { x: 6.396, y: 4.189 },
  { x: 4.011, y: 5.173 },
  { x: 7.662, y: 6.019 },
  { x: 10.523, y: 2.457 },
  { x: 10.656, y: 4.64 },
  { x: 10.735, y: 5.745 },
].map((d) => ({
  ...d,
  style: `left:${X(d.x)};top:${Y(d.y)};width:${X(0.123)};aspect-ratio:1`,
}));

type Part = { t: string; color?: string; size?: number };
type Label = { x: number; y: number; w: number; h: number; size: number; bold?: boolean; parts: Part[] };

/** 文字标签（字号 12/14/16/20/24pt；灰度标签为原稿中弱化的「加工」两项） */
const labels: Label[] = [
  {
    x: 0.191,
    y: 0.242,
    w: 9.971,
    h: 0.503,
    size: 24,
    bold: true,
    parts: [{ t: '结构图示', color: '#1C4885' }],
  },
  { x: 4.256, y: 1.963, w: 0.987, h: 0.337, size: 14, parts: [{ t: '数据接口' }] },
  { x: 6.142, y: 2.938, w: 1.885, h: 0.303, size: 12, parts: [{ t: '轴承零部件参数化建模' }] },
  { x: 1.469, y: 3.436, w: 1.576, h: 0.337, size: 14, parts: [{ t: '参数化结构设计' }] },
  // 原稿此标签 x=5.521，左缘落在竖直主干线（x=5.559）左侧 0.038in，导致竖线穿过「墨」字。
  // 右移至让开该线（线右缘 5.575），其余两个模块标签位置不变。
  { x: 5.615, y: 3.915, w: 1.024, h: 0.337, size: 14, parts: [{ t: '墨·CAS' }] },
  { x: 4.16, y: 4.898, w: 1.024, h: 0.337, size: 14, parts: [{ t: '墨·TAV' }] },
  {
    x: 7.195,
    y: 4.788,
    w: 1.611,
    h: 0.505,
    size: 12,
    parts: [{ t: '三维自动标注 MBD 模型自动生成' }],
  },
  { x: 5.971, y: 5.758, w: 1.235, h: 0.337, size: 14, parts: [{ t: '墨·DAG' }] },
  { x: 1.084, y: 6.54, w: 2.754, h: 0.337, size: 14, parts: [{ t: '关节轴承组件三维尺寸链分析' }] },
  {
    x: 4.805,
    y: 6.615,
    w: 3.035,
    h: 0.438,
    size: 20,
    bold: true,
    parts: [
      { t: '总耗时：' },
      { t: '5', color: '#FF0000' },
      { t: '分钟', color: '#FF0000', size: 16 },
      { t: '/', size: 16 },
      { t: '个', size: 16 },
    ],
  },
  { x: 5.845, y: 6.13, w: 1.38, h: 0.337, size: 14, parts: [{ t: '符合最新国标' }] },
  { x: 8.302, y: 6.725, w: 1.548, h: 0.303, size: 12, parts: [{ t: '二维图纸自动生成' }] },
  { x: 9.633, y: 2.18, w: 0.987, h: 0.337, size: 14, parts: [{ t: '检测规范' }] },
  { x: 10.858, y: 3.733, w: 1.773, h: 0.337, size: 14, parts: [{ t: '检测表单自动生成' }] },
  { x: 9.748, y: 4.344, w: 0.987, h: 0.337, size: 14, parts: [{ t: '加工规范', color: '#A6A6A6' }] },
  {
    x: 10.858,
    y: 4.531,
    w: 1.773,
    h: 0.337,
    size: 14,
    parts: [{ t: '加工工艺自动生成', color: '#A6A6A6' }],
  },
  { x: 10.018, y: 5.459, w: 0.791, h: 0.337, size: 14, parts: [{ t: '老国标' }] },
  {
    x: 10.974,
    y: 6.386,
    w: 1.548,
    h: 0.505,
    size: 12,
    parts: [{ t: '降版图纸自动生成（对接现有能力）' }],
  },
];

type Pic = {
  x: number;
  y: number;
  w: number;
  h: number;
  img: string;
  alt: string;
  caption: string;
  video?: string;
  /** 顶部裁切比例（原稿 image18 的 srcRect t=16.25%） */
  cropTop?: number;
  /** 红框标注（相对外框的百分比） */
  mark?: { left: string; top: string; width: string; height: string };
};

const pics: Pic[] = [
  {
    x: 0.66,
    y: 1.451,
    w: 3.25,
    h: 1.917,
    img: `${M}/image17.png`,
    alt: '轴承尺寸链计算表',
    caption: '尺寸链计算：轴承平均直径与内／外沟径、挡边径、沟位置推导',
  },
  {
    x: 5.728,
    y: 1.39,
    w: 2.457,
    h: 1.549,
    img: `${M}/image10.png`,
    alt: 'UG NX 中的自动标注工具条',
    caption: '视频：UG NX 内自动标注工具条演示',
    // 原 pptx 内嵌视频为 MPEG-4 Part 2（mp4v）编码，浏览器无法播放，已转码为 H.264
    video: `${M}/media1-h264.mp4`,
  },
  {
    x: 10.762,
    y: 1.371,
    w: 1.869,
    h: 2.294,
    img: `${M}/image11.png`,
    alt: '轴承尺寸定义规范表',
    caption: '检测规范 · 尺寸定义表：外圈厚／外圈直径／内圈厚／内圈直径的取值与计算基准',
  },
  {
    x: 6.799,
    y: 3.341,
    w: 2.296,
    h: 1.447,
    img: `${M}/image12.png`,
    alt: '墨·CAS 检图项目面板',
    caption: '视频：墨·CAS 检图项目面板（一键检图／出图）',
    video: `${M}/media2.mp4`,
  },
  {
    x: 0.709,
    y: 4.078,
    w: 1.713,
    h: 1.071,
    img: `${M}/image18.png`,
    alt: '柔性轴承二维装配图',
    caption: '二维装配图自动出图（含零件明细表与技术要求），红框为自动生成的技术要求',
    cropTop: 0.1625,
    mark: { left: '20.2%', top: '84.4%', width: '27.3%', height: '12.4%' },
  },
  {
    x: 2.454,
    y: 4.07,
    w: 1.548,
    h: 1.08,
    img: `${M}/image15.png`,
    alt: '公差分布分析报告',
    caption: '尺寸链分析 · 公差分布分析（CP/CPK 与合格率）',
  },
  {
    x: 0.732,
    y: 5.197,
    w: 1.69,
    h: 1.188,
    img: `${M}/image14.png`,
    alt: '公差因素影响因子报告',
    caption: '尺寸链分析 · 公差因素影响因子（L1–L5）',
  },
  {
    x: 2.459,
    y: 5.197,
    w: 1.548,
    h: 1.177,
    img: `${M}/image16.png`,
    alt: '公差因素影响因子明细',
    caption: '尺寸链分析 · 公差因素影响因子明细（垂直度／线性）',
  },
  {
    x: 7.898,
    y: 5.304,
    w: 2.153,
    h: 1.434,
    img: `${M}/image13.jpeg`,
    alt: '轴承套圈 MBD 模型形位公差标注',
    caption: 'MBD 模型自动标注：轴承套圈剖视图的尺寸与形位公差',
  },
  {
    x: 10.958,
    y: 5.272,
    w: 1.988,
    h: 1.011,
    img: `${M}/image19.png`,
    alt: '国标形状与位置公差标注示例',
    caption: '老国标 · 形状与位置公差标注示例（圆度／圆柱度／垂直度）',
  },
];
---

<div class="-mx-6 overflow-x-auto px-6 pb-1 lg:mx-0 lg:overflow-visible lg:px-0">
  <div
    class="@container relative w-full min-w-[900px] rounded-xl border border-ink/[0.08] bg-white shadow-sm"
    style="aspect-ratio:13333/7500"
  >
    <!-- 标题左侧的深蓝色装饰竖条 -->
    <span
      class="absolute block bg-[#1C4885]"
      style={`left:0;top:${Y(0.207)};width:${X(0.158)};height:${Y(0.507)}`}
      aria-hidden="true"
    ></span>

    <!-- 流程连线 -->
    {
      lines.map((l) => (
        <span
          class:list={['absolute block', l.gradient ? 'diagram-line-gradient' : 'bg-[#0070C0]', l.dash && 'diagram-line-dash']}
          style={l.style}
          aria-hidden="true"
        />
      ))
    }

    <!-- 节点圆点 -->
    {
      dots.map((d) => (
        <span
          class="absolute block rounded-full border-[0.06cqw] border-[#41464C]/70 bg-[#2D80C5]"
          style={d.style}
          aria-hidden="true"
        />
      ))
    }

    <!-- 文字标签 -->
    {
      labels.map((l) => (
        <div
          class="absolute flex flex-col justify-center leading-[1.15] text-ink"
          style={`${box(l)}font-size:${FS(l.size)};${l.bold ? 'font-weight:700;' : ''}`}
        >
          <p class="m-0">
            {l.parts.map((p) => (
              <span style={`${p.color ? `color:${p.color};` : ''}${p.size ? `font-size:${FS(p.size)};` : ''}`}>
                {p.t}
              </span>
            ))}
          </p>
        </div>
      ))
    }

    <!-- 图片与视频（图片点击放大，视频点击播放） -->
    {
      pics.map((p) => {
        const crop = p.cropTop ?? 0;
        const imgStyle = crop
          ? `top:${((-crop / (1 - crop)) * 100).toFixed(2)}%;height:${(100 / (1 - crop)).toFixed(2)}%`
          : 'top:0;height:100%';
        const mark = p.mark && (
          <span
            class="pointer-events-none absolute border-[0.07cqw] border-[#FF0000]"
            style={`left:${p.mark.left};top:${p.mark.top};width:${p.mark.width};height:${p.mark.height}`}
            aria-hidden="true"
          />
        );

        return (
          <div class="absolute overflow-hidden bg-white" style={box(p)}>
            {p.video ? (
              <button
                type="button"
                class="group absolute inset-0 block cursor-pointer border-0 bg-transparent p-0"
                data-lb-video={p.video}
                data-lb-poster={p.img}
                data-lb-caption={p.caption}
                aria-label={`播放${p.caption}`}
              >
                <img class="absolute left-0 w-full object-fill" style={imgStyle} src={p.img} alt={p.alt} loading="lazy" />
                <span class="absolute inset-0 grid place-items-center bg-ink/15 transition group-hover:bg-ink/30">
                  <span
                    class="grid place-items-center rounded-full bg-white/95 shadow-md"
                    style={`width:${FS(30)};height:${FS(30)}`}
                  >
                    <svg
                      viewBox="0 0 24 24"
                      style={`width:${FS(14)};height:${FS(14)}`}
                      class="fill-brand-deep"
                      aria-hidden="true"
                    >
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                </span>
              </button>
            ) : (
              <>
                <img
                  class="zoomable absolute left-0 w-full cursor-zoom-in object-fill"
                  style={imgStyle}
                  src={p.img}
                  alt={p.alt}
                  data-lb-caption={p.caption}
                  loading="lazy"
                />
                {mark}
              </>
            )}
          </div>
        );
      })
    }
  </div>
</div>

<p class="mt-3 mb-0 text-center text-[0.8rem] text-muted">
  点击图片可放大，点击视频封面可播放。
</p>

<style>
  /* 原稿中由「墨·DAG」指向左侧图纸的渐变连线 */
  .diagram-line-gradient {
    background-image: linear-gradient(to right, #beddf0, #2d80c5);
  }
  /* 原稿中加工规范分支的虚线 */
  .diagram-line-dash {
    background-image: repeating-linear-gradient(
      to right,
      #0070c0 0 6px,
      transparent 6px 11px
    );
  }
</style>
