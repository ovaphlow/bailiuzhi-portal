---
interface Props {
  /** 金色等宽小标题，如 "01 · 统一用户入口" */
  sub?: string;
  title: string;
  desc?: string;
  /** 要点列表：金色方块引导的 li */
  points?: string[];
  img?: string;
  alt?: string;
  /** 图片说明文字 */
  caption?: string;
  /** 图文位置互换（图左文右） */
  flip?: boolean;
}
const { sub, title, desc, points = [], img, alt = '', caption, flip = false } = Astro.props;
---

<!-- 图文交替区块：内页正文的主要节奏单元（对应原站 .feature） -->
<div class:list={["grid items-center gap-8", img && "md:grid-cols-2"]}>
  <div class="flex flex-col">
    {sub && <div class="mb-2 font-mono text-[0.75rem] tracking-[0.1em] text-gold-deep">{sub}</div>}
    <h3 class="mt-0 mb-2.5 text-xl font-semibold text-brand-deep">{title}</h3>
    {desc && <p class="m-0 text-[0.95rem] text-muted">{desc}</p>}
    {
      points.length > 0 && (
        <ul class="mt-3 mb-0 list-none space-y-2 p-0">
          {points.map((point) => (
            <li class="relative pl-5 text-[0.9rem] leading-relaxed text-muted before:absolute before:left-0 before:top-[0.5em] before:h-2 before:w-2 before:rounded-sm before:bg-gold before:content-['']">
              {point}
            </li>
          ))}
        </ul>
      )
    }
  </div>
  {
    img && (
      <figure class:list={['m-0', flip && 'md:order-first']}>
        <img
          class="block w-full rounded-xl border border-ink/[0.08] bg-white object-cover"
          src={img}
          alt={alt}
          loading="lazy"
        />
        {caption && <figcaption class="mt-2 text-[0.85rem] text-muted">{caption}</figcaption>}
      </figure>
    )
  }
</div>
