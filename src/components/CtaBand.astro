---
interface Props {
  /** 副文案 */
  sub?: string;
}
const {
  sub = '百六智持续赋能中国高端制造企业，让每一家追求卓越的制造企业，都拥有专属「智慧大脑」。',
} = Astro.props;
---

<!-- 底部号召（CTA）：各页共用，标题用默认插槽覆盖 -->
<section class="py-24 text-center">
  <div class="mx-auto max-w-300 px-6 lg:px-10">
    <h2
      class="mb-4 text-[clamp(1.75rem,4vw,2.5rem)] leading-[1.3] font-semibold text-brand-deep"
    >
      <slot>
        立足无锡、服务全国、走向世界，<br />携手共赴<span class="text-gold-deep">「智造」</span>新高度
      </slot>
    </h2>
    <p class="mx-auto max-w-[560px] text-muted">{sub}</p>
  </div>
</section>
