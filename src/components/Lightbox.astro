---
/**
 * 媒体灯箱组件：点击可放大浏览，支持前后切换与 Esc 关闭。
 *
 * 使用方页面引入 <Lightbox /> 后：
 *   - img.zoomable                      → 点击放大图片
 *   - [data-lb-video="xxx.mp4"]         → 点击在灯箱内播放视频（data-lb-poster 作为封面）
 * 说明文字取自最近的 figure > figcaption，其次 img 的 alt / data-lb-caption。
 */

---

<div id="lb-overlay" class="lb-overlay" aria-hidden="true">
  <button class="lb-close" aria-label="关闭">&times;</button>
  <button class="lb-prev" aria-label="上一张">&#10094;</button>
  <button class="lb-next" aria-label="下一张">&#10095;</button>
  <div class="lb-body">
    <img class="lb-img" alt="" />
    <video class="lb-video" controls playsinline preload="none"></video>
    <div class="lb-cap"></div>
  </div>
</div>

<style>
  .lb-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(4px);
    justify-content: center;
    align-items: center;
  }
  .lb-overlay.open {
    display: flex;
  }
  .lb-body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 90vw;
    max-height: 90vh;
  }
  .lb-img {
    max-width: 88vw;
    max-height: 80vh;
    border-radius: 8px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    object-fit: contain;
    background: #fff;
  }
  .lb-video {
    display: none;
    max-width: 88vw;
    max-height: 80vh;
    border-radius: 8px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    background: #000;
  }
  .lb-overlay.is-video .lb-img {
    display: none;
  }
  .lb-overlay.is-video .lb-video {
    display: block;
  }
  .lb-cap {
    margin-top: 12px;
    color: rgba(255,255,255,0.88);
    font-size: 0.88rem;
    text-align: center;
    max-width: 80vw;
    line-height: 1.5;
  }
  .lb-close,
  .lb-prev,
  .lb-next {
    position: absolute;
    z-index: 10;
    background: none;
    border: none;
    color: #fff;
    font-size: 2rem;
    cursor: pointer;
    padding: 12px;
    line-height: 1;
    opacity: 0.85;
    transition: opacity 0.15s;
  }
  .lb-close:hover,
  .lb-prev:hover,
  .lb-next:hover {
    opacity: 1;
  }
  .lb-close {
    top: 8px;
    right: 12px;
    font-size: 2.2rem;
  }
  .lb-prev {
    left: 8px;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-next {
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
  }
</style>

<script>
  (function () {
    var overlay = document.getElementById('lb-overlay');
    if (!overlay) return;

    var lbImg = overlay.querySelector('.lb-img');
    var lbVideo = overlay.querySelector('.lb-video');
    var lbCap = overlay.querySelector('.lb-cap');
    var triggers = Array.from(document.querySelectorAll('img.zoomable, [data-lb-video]'));
    if (!triggers.length) return;

    // 统一成 { kind, src, poster, caption, alt } 列表，顺序即页面 DOM 顺序
    var items = triggers.map(function (el) {
      var isVideo = el.hasAttribute('data-lb-video');
      var cap =
        el.getAttribute('data-lb-caption') ||
        el.closest('figure')?.querySelector('figcaption')?.textContent?.trim() ||
        '';
      if (isVideo) {
        return {
          kind: 'video',
          src: el.getAttribute('data-lb-video'),
          poster: el.getAttribute('data-lb-poster') || '',
          caption: cap,
          alt: el.getAttribute('aria-label') || '视频',
        };
      }
      return { kind: 'img', src: el.currentSrc || el.src, caption: cap || el.alt || '', alt: el.alt || '' };
    });

    var current = 0;

    function stopVideo() {
      if (!lbVideo) return;
      lbVideo.pause();
      lbVideo.removeAttribute('src');
      lbVideo.removeAttribute('poster');
      lbVideo.load();
    }

    function show(i) {
      current = (i + items.length) % items.length;
      var item = items[current];
      if (item.kind === 'video') {
        overlay.classList.add('is-video');
        if (lbVideo.getAttribute('src') !== item.src) {
          lbVideo.setAttribute('src', item.src);
          if (item.poster) lbVideo.setAttribute('poster', item.poster);
        }
        // 不要在此处调用 load()：它会中断紧随其后的 play()（AbortError）
        var playing = lbVideo.play();
        if (playing && playing.catch) playing.catch(function () {});
      } else {
        stopVideo();
        overlay.classList.remove('is-video');
        lbImg.src = item.src;
        lbImg.alt = item.alt;
      }
      lbCap.textContent = item.caption;
    }

    function open(i, fromEl) {
      // 若已有视频在播，先切到目标项
      show(i);
      overlay.classList.add('open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      if (fromEl && !fromEl.classList.contains('zoomable')) fromEl.blur?.();
    }

    function close() {
      stopVideo();
      overlay.classList.remove('open', 'is-video');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    triggers.forEach(function (el, i) {
      if (el.tagName === 'IMG' && el.classList.contains('zoomable') && !el.hasAttribute('data-lb-video')) {
        el.classList.add('cursor-zoom-in');
      }
      el.addEventListener('click', function (e) {
        e.preventDefault();
        open(i, el);
      });
    });

    overlay.addEventListener('click', function (e) {
      if (e.target === overlay || e.target.classList.contains('lb-body')) close();
    });
    overlay.querySelector('.lb-close')?.addEventListener('click', close);
    overlay.querySelector('.lb-prev')?.addEventListener('click', function (e) {
      e.stopPropagation(); show(current - 1);
    });
    overlay.querySelector('.lb-next')?.addEventListener('click', function (e) {
      e.stopPropagation(); show(current + 1);
    });

    document.addEventListener('keydown', function (e) {
      if (!overlay.classList.contains('open')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(current - 1);
      else if (e.key === 'ArrowRight') show(current + 1);
    });
  })();
</script>
