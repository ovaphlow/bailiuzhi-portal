---
/**
 * 图片灯箱组件：点击 zoomable 图片可放大浏览，支持前后切换与 Esc 关闭。
 * 在使用方页面引入 <Lightbox /> 即可，配合 img.zoomable class。
 */

---

<div id="lb-overlay" class="lb-overlay" aria-hidden="true">
  <button class="lb-close" aria-label="关闭">&times;</button>
  <button class="lb-prev" aria-label="上一张">&#10094;</button>
  <button class="lb-next" aria-label="下一张">&#10095;</button>
  <div class="lb-body">
    <img class="lb-img" alt="" />
    <div class="lb-cap"></div>
  </div>
</div>

<style>
  .lb-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(15, 23, 42, 0.88);
    backdrop-filter: blur(4px);
    justify-content: center;
    align-items: center;
  }
  .lb-overlay.open {
    display: flex;
  }
  .lb-body {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 90vw;
    max-height: 90vh;
  }
  .lb-img {
    max-width: 88vw;
    max-height: 80vh;
    border-radius: 8px;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    object-fit: contain;
    background: #fff;
  }
  .lb-cap {
    margin-top: 12px;
    color: rgba(255,255,255,0.88);
    font-size: 0.88rem;
    text-align: center;
    max-width: 80vw;
    line-height: 1.5;
  }
  .lb-close,
  .lb-prev,
  .lb-next {
    position: absolute;
    z-index: 10;
    background: none;
    border: none;
    color: #fff;
    font-size: 2rem;
    cursor: pointer;
    padding: 12px;
    line-height: 1;
    opacity: 0.85;
    transition: opacity 0.15s;
  }
  .lb-close:hover,
  .lb-prev:hover,
  .lb-next:hover {
    opacity: 1;
  }
  .lb-close {
    top: 8px;
    right: 12px;
    font-size: 2.2rem;
  }
  .lb-prev {
    left: 8px;
    top: 50%;
    transform: translateY(-50%);
  }
  .lb-next {
    right: 8px;
    top: 50%;
    transform: translateY(-50%);
  }
</style>

<script>
  (function () {
    var overlay = document.getElementById('lb-overlay');
    if (!overlay) return;

    var lbImg = overlay.querySelector('.lb-img');
    var lbCap = overlay.querySelector('.lb-cap');
    var imgs = Array.from(document.querySelectorAll('img.zoomable'));
    if (!imgs.length) return;

    var current = 0;

    function captionFor(img) {
      var cap = img.closest('figure')?.querySelector('figcaption');
      return cap?.textContent?.trim() || img.alt || '';
    }

    function show(i) {
      current = (i + imgs.length) % imgs.length;
      lbImg.src = imgs[current].src;
      lbImg.alt = imgs[current].alt || '';
      lbCap.textContent = captionFor(imgs[current]);
    }

    function open(i) {
      show(i);
      overlay.classList.add('open');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      overlay.classList.remove('open');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }

    imgs.forEach(function (img, i) {
      img.classList.add('cursor-zoom-in');
      img.addEventListener('click', function () { open(i); });
    });

    overlay.addEventListener('click', function (e) {
      if (e.target === overlay || e.target.classList.contains('lb-body')) close();
    });
    overlay.querySelector('.lb-close')?.addEventListener('click', close);
    overlay.querySelector('.lb-prev')?.addEventListener('click', function (e) {
      e.stopPropagation(); show(current - 1);
    });
    overlay.querySelector('.lb-next')?.addEventListener('click', function (e) {
      e.stopPropagation(); show(current + 1);
    });

    document.addEventListener('keydown', function (e) {
      if (!overlay.classList.contains('open')) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft') show(current - 1);
      else if (e.key === 'ArrowRight') show(current + 1);
    });
  })();
</script>
