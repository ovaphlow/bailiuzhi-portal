---
/**
 * 机器视觉光源案例「参数驱动出图」示意（纯 SVG 绘制，作为 Card 插槽内容）。
 * 尺寸参数 → 参数驱动生成 → 可直接交付的零件图纸。
 * 不含外框：外框由所在 Card 提供，以便与同排卡片的边框、内边距完全对齐。
 */
const C = {
  deep: '#0f2e63',
  brand: '#1d4ed8',
  soft: '#f8fafc',
  muted: '#64748b',
  line: '#e2e8f0',
};
---

<svg
  viewBox="0 0 520 250"
  role="img"
  aria-label="参数驱动出图：输入尺寸参数即可自动生成可直接交付的零件图纸，新增尺寸需求同样适用。"
  class="mt-5 block h-auto w-full"
>
  <title>参数驱动出图</title>

  <!-- 尺寸参数 -->
  <rect x={0} y={0} width={520} height={60} rx={8} fill={C.soft} stroke={C.line} />
  <text x={14} y={36} font-size="12.5" fill={C.deep}>尺寸参数</text>
  <g fill="#cbd5e1">
    <rect x={100} y={20} width={100} height={8} rx={4} />
    <rect x={212} y={20} width={60} height={8} rx={4} />
    <rect x={100} y={40} width={70} height={8} rx={4} />
    <rect x={182} y={40} width={90} height={8} rx={4} />
  </g>
  <rect x={352} y={12} width={156} height={36} rx={6} fill={C.brand} />
  <text x={430} y={35} text-anchor="middle" font-size="13" font-weight="600" fill="#ffffff">参数驱动生成</text>

  <!-- 箭头 -->
  <line x1={260} y1={62} x2={260} y2={92} stroke={C.brand} stroke-width="2" />
  <polygon points="255,92 260,104 265,92" fill={C.brand} />

  <!-- 图纸 -->
  <g stroke={C.brand} stroke-width="2" fill="none">
    <circle cx={140} cy={180} r={44} />
    <circle cx={140} cy={180} r={19} stroke-width="1.5" />
  </g>
  <g stroke={C.muted} stroke-width="1.2">
    <line x1={88} y1={238} x2={192} y2={238} />
    <line x1={88} y1={235} x2={88} y2={241} />
    <line x1={192} y1={235} x2={192} y2={241} />
    <line x1={82} y1={136} x2={82} y2={224} />
    <line x1={79} y1={136} x2={85} y2={136} />
    <line x1={79} y1={224} x2={85} y2={224} />
  </g>
  <rect x={250} y={130} width={270} height={92} rx={6} fill={C.soft} stroke={C.line} />
  <text x={270} y={166} font-size="13" font-weight="600" fill={C.deep}>零件图纸</text>
  <text x={270} y={192} font-size="12.5" fill={C.muted}>自动生成、可直接交付</text>
</svg>
