---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Feature from '../components/Feature.astro';
import Figure from '../components/Figure.astro';
import ContactSection from '../components/ContactSection.astro';
import CtaBand from '../components/CtaBand.astro';
---

<BaseLayout
  title="航天行业 MBD 设计检测一体化案例 · 百六智数字科技"
  description="面向航天行业的 MBD 设计检测一体化方案，保障高可靠、高精度要求下的质量与效率，实现复材装配体智能拆分、快速出图。"
>
  <PageHero
    kicker="AEROSPACE MBD"
    title="航天行业 MBD 设计检测一体化"
    lede="面向航天行业的 MBD 设计检测一体化方案，保障高可靠、高精度要求下的质量与效率，实现复材装配体智能拆分、快速出图。"
  />

  <section id="intro" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead eyebrow="Background" title="案例背景" />
      <Feature
        desc="航天行业对可靠性与精度要求极高，复材装配体零件数量大、结构复杂，设计与检测交付周期紧。"
        points={[
          '1000 多个零件、150 多种零件的复材装配体智能拆分',
          '相似零件、相似装配结构自动识别与分类',
          '零件图纸生成 <1 分钟/个，全自动出图缩短交付周期',
          '自动生成检验计划，MBD 设计检测一体化保障航天级质量',
        ]}
        img="/assets/media/review/%EF%BC%88%E9%80%9A%E7%94%A8%EF%BC%89%E9%9D%9E%E6%A0%87%E8%AE%BE%E8%AE%A1%E8%87%AA%E5%8A%A8%E5%8C%96%E7%B3%BB%E7%BB%9F%E6%96%B9%E6%A1%88V2.0/image129.png"
        alt="航天复材装配体智能拆分"
        caption="航天复材装配体智能拆分、快速出图一体化方案"
      />
    </div>
  </section>

  <section id="solutions" class="bg-surface py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead eyebrow="Solutions" title="方案要点 · 图文详解" desc="智能拆分、精度设计与检验出图闭环。" />
      <div class="grid gap-10">
        <Feature
          sub="01 · AI 识别与 BOM 提取"
          title="复材装配体智能拆分"
          desc="AI 识别与分类、BOM 快速提取，航天复材装配体快速拆分、快速出图。"
          points={['自动识别与分类零件', 'BOM 快速提取与组织']}
          img="/assets/media/review/%EF%BC%88%E9%80%9A%E7%94%A8%EF%BC%89%E9%9D%9E%E6%A0%87%E8%AE%BE%E8%AE%A1%E8%87%AA%E5%8A%A8%E5%8C%96%E7%B3%BB%E7%BB%9F%E6%96%B9%E6%A1%88V2.0/image133.png"
          alt="AI 识别与 BOM 提取"
          caption="AI 识别与分类、BOM 快速提取"
        />
        <Feature
          flip
          sub="02 · 精度设计与检验出图"
          title="航天级质量保障"
          desc="自动精度设计、检验计划自动生成与全自动出图，保障高可靠、高精度要求下的质量与效率。"
          points={['检验计划自动生成', '全自动出图缩短交付周期']}
          img="/assets/media/review/%EF%BC%88%E9%80%9A%E7%94%A8%EF%BC%89%E9%9D%9E%E6%A0%87%E8%AE%BE%E8%AE%A1%E8%87%AA%E5%8A%A8%E5%8C%96%E7%B3%BB%E7%BB%9F%E6%96%B9%E6%A1%88V2.0/image135.png"
          alt="自动精度设计与出图"
          caption="自动精度设计、检验计划生成与全自动出图"
        />
        <Feature
          sub="03 · 全自动出图链路"
          title="从装配 CAD 导入到检验计划生成"
          desc="装配 CAD 导入 → BOM 快速提取 → AI 识别与分类 → 自动精度设计 → 自动生成检验计划 → 全自动出图，全流程贯通。"
          points={['相似零件与相似装配结构自动识别分类', '零件图纸生成 <1 分钟/个']}
          img="/assets/media/docs/company-profile/elements/v4-p42-a.jpg"
          alt="航天复材装配体智能拆分案例"
        />
        <div class="grid gap-6 md:grid-cols-2">
          <Figure
            img="/assets/media/review/%EF%BC%88%E9%80%9A%E7%94%A8%EF%BC%89%E9%9D%9E%E6%A0%87%E8%AE%BE%E8%AE%A1%E8%87%AA%E5%8A%A8%E5%8C%96%E7%B3%BB%E7%BB%9F%E6%96%B9%E6%A1%88V2.0/image137.png"
            alt="复材装配体拆分"
            caption="航天复材装配体智能拆分、快速出图"
          />
        </div>
      </div>
    </div>
  </section>

  <ContactSection />
  <CtaBand sub="高可靠、高精度要求下的设计检测一体化。">
    航天级质量，<span class="text-gold-deep">智能化交付</span>
  </CtaBand>
</BaseLayout>
