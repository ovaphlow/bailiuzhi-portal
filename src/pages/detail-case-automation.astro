---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Feature from '../components/Feature.astro';
import Figure from '../components/Figure.astro';
import ContactSection from '../components/ContactSection.astro';
import CtaBand from '../components/CtaBand.astro';
---

<BaseLayout
  title="非标自动化行业设计出图案例 · 百六智数字科技"
  description="装配批量导入、图纸一键生成，显著提升非标自动化行业的设计出图效率，图纸生成提速 5–8 倍。"
>
  <PageHero
    kicker="AUTOMATION"
    title="非标自动化行业设计出图"
    lede="装配批量导入、图纸一键生成，显著提升非标自动化行业的设计出图效率，图纸生成提速 5–8 倍。"
  />

  <section id="intro" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead eyebrow="Background" title="案例背景" />
      <Feature
        desc="非标自动化产线组件多、改型快、出图量大，传统人工标注出图周期长，制约交付速度。"
        points={[
          '装配批量导入，图纸一键生成，应对快速多变的出图需求',
          '自动标注与自动出图，图纸生成提速 5–8 倍（2 组件/套件场景实测）',
          '自动精度设计与检测表单自动生成，出图与检测一致贯通',
          '精度智能设计 + 自动替人出图 + 智能读图应用，全链路提效',
        ]}
        img="/assets/media/review/%E9%9D%9E%E6%A0%87%E8%87%AA%E5%8A%A8%E5%8C%96%E4%BA%A7%E7%BA%BF%E8%A1%8C%E4%B8%9A%E6%A1%88%E4%BE%8B-%E8%87%AA%E5%8A%A8%E6%A0%87%E6%B3%A8%E4%B8%8E%E8%87%AA%E5%8A%A8%E5%87%BA%E5%9B%BE/image11.png"
        alt="产线出图对比图示"
        caption="产线出图对比：自动出图提速 5–8 倍"
      />
    </div>
  </section>

  <section id="solutions" class="bg-surface py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead eyebrow="Solutions" title="方案要点 · 图文详解" desc="一键出图、方案应用与实测成效。" />
      <div class="grid gap-10">
        <Feature
          sub="01 · 一键出图"
          title="装配批量导入、图纸一键生成"
          desc="装配批量导入后图纸一键生成，自动出图效果直接可交付，应对快速多变出图需求。"
          points={[
            '分组件实测提速 5 / 6.5 / 7.5 / 8 倍',
            '出图速度 0.5 分钟/标注，实测标注量 300+ / 750+ / 600+ / 800+ 个',
            '组件/套件批量场景实测验证',
          ]}
          img="/assets/media/review/%E9%9D%9E%E6%A0%87%E8%87%AA%E5%8A%A8%E5%8C%96%E4%BA%A7%E7%BA%BF%E8%A1%8C%E4%B8%9A%E6%A1%88%E4%BE%8B-%E8%87%AA%E5%8A%A8%E6%A0%87%E6%B3%A8%E4%B8%8E%E8%87%AA%E5%8A%A8%E5%87%BA%E5%9B%BE/image10.png"
          alt="自动出图提速概览"
          caption="非标行业快速多变出图需求的解决方案与应用"
        />
        <Feature
          flip
          sub="02 · 方案应用"
          title="自动出图效果一览"
          desc="装配批量导入、图纸一键生成的实际出图效果，配合自动精度设计保证质量一致性。"
          points={['自动标注与自动出图全流程', '检测表单同步自动生成']}
          img="/assets/media/review/%E9%9D%9E%E6%A0%87%E8%87%AA%E5%8A%A8%E5%8C%96%E4%BA%A7%E7%BA%BF%E8%A1%8C%E4%B8%9A%E6%A1%88%E4%BE%8B-%E8%87%AA%E5%8A%A8%E6%A0%87%E6%B3%A8%E4%B8%8E%E8%87%AA%E5%8A%A8%E5%87%BA%E5%9B%BE/image12.png"
          alt="批量导入一键出图"
          caption="装配批量导入、图纸一键生成的出图效果"
        />
        <Feature
          sub="03 · 出图检测贯通"
          title="自动精度设计与检测表单同步生成"
          desc="自动精度设计与检测表单同步自动生成，出图与检测一致贯通，精度智能设计、自动替人出图、智能读图应用贯穿全链路。"
          points={['精度设计 + 自动出图 + 智能读图全链路', '改型一键驱动，图纸与检测同步更新']}
          img="/assets/media/docs/company-profile/elements3/v3-p39.jpg"
          alt="非标自动化出图案例"
        />
        <div class="grid gap-6 md:grid-cols-2">
          <Figure
            img="/assets/media/review/%E9%9D%9E%E6%A0%87%E8%87%AA%E5%8A%A8%E5%8C%96%E4%BA%A7%E7%BA%BF%E8%A1%8C%E4%B8%9A%E6%A1%88%E4%BE%8B-%E8%87%AA%E5%8A%A8%E6%A0%87%E6%B3%A8%E4%B8%8E%E8%87%AA%E5%8A%A8%E5%87%BA%E5%9B%BE/image13.png"
            alt="产线出图提速对比"
            caption="产线出图组件与提速对比"
          />
        </div>
      </div>
    </div>
  </section>

  <ContactSection />
  <CtaBand sub="装配批量导入、图纸自动生成，交付提速 5–8 倍。">
    让非标出图 <span class="text-gold-deep">一键完成</span>
  </CtaBand>
</BaseLayout>
