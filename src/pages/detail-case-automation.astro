---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import AutomationFlow from '../components/AutomationFlow.astro';
import Lightbox from '../components/Lightbox.astro';
import ContactSection from '../components/ContactSection.astro';
import CtaBand from '../components/CtaBand.astro';
import { Image, getImage } from 'astro:assets';
import poster1 from '../assets/media/review/automation/demo1-poster.png';
import poster2 from '../assets/media/review/automation/demo2-poster.png';
import poster3 from '../assets/media/review/automation/demo3-poster.png';
import poster4 from '../assets/media/review/automation/demo4-poster.png';

/** 演示视频仍在 public/（astro:assets 不处理视频），目录名含中文，引用需 URL 编码 */
const V =
  '/assets/media/review/%E9%9D%9E%E6%A0%87%E8%87%AA%E5%8A%A8%E5%8C%96%E4%BA%A7%E7%BA%BF%E8%A1%8C%E4%B8%9A%E6%A1%88%E4%BE%8B-%E8%87%AA%E5%8A%A8%E6%A0%87%E6%B3%A8%E4%B8%8E%E8%87%AA%E5%8A%A8%E5%87%BA%E5%9B%BE';

/**
 * 总体指标，依据《非标自动化产线行业案例-自动标注与自动出图.pptx》第 2 页：
 * 出图速度 0.5 分/标注、1~5 分钟/零件，四个实测项目提速 5 / 6.5 / 7.5 / 8 倍。
 */
const kpis = [
  { value: '5–8 倍', label: '四组件实测提速' },
  { value: '0.5 分/标注', label: '出图速度' },
  { value: '1~5 分钟/零件', label: '单零件出图时间' },
];

/**
 * 四个实测项目（同上第 2 页）。demoN.mp4 为 pptx 内嵌演示视频，
 * 原为 HEVC 编码浏览器无法播放，已转码为 H.264；demoN-poster.png 为原视频封面。
 */
const demos = [
  {
    name: '定位组件',
    scale: '2 组件 / 4 零件',
    marks: '300+ 个标注',
    manual: '人工 1 人 / 2+ 小时',
    speedup: '5 倍',
  },
  {
    name: '承载板',
    scale: '1 零件',
    marks: '750+ 个标注',
    manual: '人工 1 人 / 5+ 小时',
    speedup: '6.5 倍',
  },
  {
    name: '随行夹具',
    scale: '1 组件 / 15 零件',
    marks: '600+ 个标注',
    manual: '人工 1 人 / 8+ 小时',
    speedup: '7.5 倍',
  },
  {
    name: '卷针组件',
    scale: '3 组件 / 17 零件',
    marks: '800+ 个标注',
    manual: '人工 1 人 / 16+ 小时',
    speedup: '8 倍',
  },
].map((d, i) => ({
  ...d,
  poster: [poster1, poster2, poster3, poster4][i],
  video: `${V}/demo${i + 1}.mp4`,
}));

/** 灯箱播放前的封面大图（约 1024px，点击播放时才请求） */
const posterSrcs = await Promise.all(
  demos.map(
    async (d) =>
      (await getImage({ src: d.poster, width: Math.min(1024, d.poster.width), format: 'webp', quality: 82 })).src
  )
);
---

<BaseLayout
  title="非标自动化行业设计出图案例 · 百六智数字科技"
  description="装配批量导入、图纸一键生成，显著提升非标自动化行业的设计出图效率，图纸生成提速 5–8 倍。"
>
  <PageHero
    kicker="AUTOMATION"
    title="非标自动化行业设计出图"
    lede="装配批量导入、图纸一键生成，显著提升非标自动化行业的设计出图效率，图纸生成提速 5–8 倍。"
  />

  <section id="overview" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Overview"
        title="非标行业快速多变出图需求的解决方案与应用"
        desc="装配批量导入、图纸一键生成，实测项目覆盖组件与单零件两类场景，出图速度 0.5 分/标注。"
      />
      <div class="grid gap-6 rounded-xl border border-brand/10 bg-brand-soft p-6 sm:grid-cols-3 md:p-8">
        {
          kpis.map((k) => (
            <div class="text-center">
              <div class="text-[clamp(1.4rem,2.6vw,1.9rem)] leading-tight font-semibold text-brand-deep">
                {k.value}
              </div>
              <div class="mt-2 text-[0.86rem] text-muted">{k.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="demos" class="bg-surface py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Results"
        title="四组件实测数据与演示"
        desc="四个实测项目的规模、标注量与人工耗时；点击封面可播放该组件的出图演示。"
      />
      <div class="grid gap-5 md:grid-cols-2">
        {
          demos.map((d, i) => (
            <div class="flex flex-col rounded-xl border border-ink/[0.08] bg-white p-5">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <h3 class="m-0 text-base font-semibold text-brand-deep">{d.name}</h3>
                <span class="text-[1.35rem] leading-none font-semibold text-gold-deep">{d.speedup}</span>
              </div>
              <p class="mt-1.5 mb-0 text-[0.85rem] text-muted">{d.scale}</p>

              <button
                type="button"
                class="group relative mt-4 block w-full cursor-pointer overflow-hidden rounded-lg border border-ink/[0.08] bg-ink/5 p-0"
                data-lb-video={d.video}
                data-lb-poster={posterSrcs[i]}
                data-lb-caption={`${d.name}（${d.scale}）出图演示`}
                aria-label={`播放${d.name}出图演示视频`}
              >
                <Image
                  class="block aspect-[3/2] w-full object-cover"
                  src={d.poster}
                  alt={`${d.name}出图演示`}
                  width={512}
                  widths={[320, 512, 768]}
                  sizes="(min-width: 768px) 510px, 88vw"
                  format="webp"
                  quality={82}
                />
                <span class="absolute inset-0 grid place-items-center bg-ink/20 transition group-hover:bg-ink/35">
                  <span class="grid h-12 w-12 place-items-center rounded-full bg-white/95 shadow-md">
                    <svg viewBox="0 0 24 24" class="ml-0.5 h-5 w-5 fill-brand-deep" aria-hidden="true">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                </span>
              </button>

              <p class="mt-auto mb-0 pt-4 text-[0.85rem] text-muted">
                {d.marks} · {d.manual}
              </p>
            </div>
          ))
        }
      </div>
      <p class="mt-3 mb-0 text-center text-[0.8rem] text-muted">
        四个项目实测：标注量 300+ ~ 800+ 个，人工耗时 2+ ~ 16+ 小时，提速 5 ~ 8 倍。
      </p>
    </div>
  </section>

  <section id="flow" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Solution"
        title="装配批量导入、图纸一键生成"
        desc="装配批量导入后，定位组件、承载板、随行夹具、卷针组件等零件图纸一键生成。"
      />
      <AutomationFlow />
      <p class="mt-3 mb-0 text-center text-[0.8rem] text-muted">
        零件无需逐张人工标注，出图速度 0.5 分/标注，单零件 1~5 分钟。
      </p>
    </div>
  </section>

  <ContactSection />
  <CtaBand />
  <Lightbox />
</BaseLayout>
