---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Card from '../components/Card.astro';
import VisionLightLibrary from '../components/VisionLightLibrary.astro';
import VisionLightAutoGen from '../components/VisionLightAutoGen.astro';
import ContactSection from '../components/ContactSection.astro';
import CtaBand from '../components/CtaBand.astro';
import Lightbox from '../components/Lightbox.astro';
import { Image, getImage } from 'astro:assets';
import lightSourcePoster from '../assets/media/review/vision-light/light-source-poster.png';

/**
 * 演示视频来自《非标设计自动化系统方案V3.0.pptx》第 32 页内嵌视频（原 media5.mp4）。
 * 已转为 H.264 + faststart；视频放 public/，astro:assets 不处理视频。
 */
const VIDEO = '/assets/media/review/vision-light/media5.mp4';

/** 灯箱播放前的封面大图（点击播放时才请求） */
const posterSrc = (
  await getImage({
    src: lightSourcePoster,
    width: Math.min(1024, lightSourcePoster.width),
    format: 'webp',
    quality: 82,
  })
).src;
---

<BaseLayout
  title="机器视觉光源选型、参数化建模、出图自动化应用案例 · 百六智数字科技"
  description="客户定制需求多、产品种类多（产品大类近二十种）、可变更参数数量多、响应慢 —— 光源自动选型 + 出图系统破解设计瓶颈。"
>
  <PageHero
    kicker="VISION LIGHTING"
    title="机器视觉光源选型、参数化建模、出图自动化软件应用案例"
    lede="客户定制需求多、产品种类多（产品大类近二十种）、可变更参数数量多、响应慢 —— 光源自动选型 + 出图系统破解设计瓶颈。"
  />

  <section id="intro" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <div class="grid gap-6 md:grid-cols-2">
        <Card
          idx="痛点"
          title="客户痛点"
          desc="机器视觉光源产品定制品类繁杂，传统人工设计响应能力跟不上业务增长。"
          points={['客户定制需求多，产品种类多（产品大类近二十种）', '可变更的参数数量多（近 40 个），设计改版频繁', '响应慢，图纸交付周期拖累订单转化']}
        />
        <Card
          idx="方案"
          title="解决方案"
          desc="为客户开发了光源自动选型和出图系统，把光源选型经验与图纸生成规则固化进软件。"
          points={['环形、条形、同轴、背光、无影、点线光源等全系列参数化建模', '近 20 个产品大类，细分种类不断完善', '可变更参数近 40 个，全部参数驱动生成']}
        />
      </div>
    </div>
  </section>

  <section id="value" class="bg-surface py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead eyebrow="Value" title="价值提升" />
      <div class="grid gap-6 md:grid-cols-2">
        <Card idx="统一管理" title="已生成产品种类统一入库" desc="统一管理已经生成过的产品种类，选型与图纸规则持续沉淀复用。" />
        <Card idx="自动生成" title="新增尺寸需求也能自动出图" desc="对于新增的尺寸需求也可以使用软件自动生成，极大提升设计效率、缩短了给客户提供图纸的时间。" />
        <Card idx="产品系列库" title="系列化建模、统一入库">
          <VisionLightLibrary />
        </Card>
        <Card idx="参数驱动" title="输入尺寸、自动出图">
          <VisionLightAutoGen />
        </Card>
      </div>
    </div>
  </section>

  <section id="demo" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Demo"
        title="选型与出图演示"
        desc="在选型软件中选定光源系列并输入关键参数，系统即时给出规格、图纸与配件信息。点击封面播放演示。"
      />
      <div class="mx-auto max-w-160">
        <div class="rounded-xl border border-ink/[0.08] bg-white p-5">
          <h3 class="m-0 text-base font-semibold text-brand-deep">条形光源选型</h3>
          <p class="mt-1.5 mb-0 text-[0.85rem] text-muted">
            PPX 产品选型 · 系列代码 PPX-TR 系列，输入光源宽度、需求长度、挡边宽度等参数
          </p>
          <button
            type="button"
            class="group relative mt-4 block w-full cursor-pointer overflow-hidden rounded-lg border border-ink/[0.08] bg-ink/5 p-0"
            data-lb-video={VIDEO}
            data-lb-poster={posterSrc}
            data-lb-caption="机器视觉光源：条形光源选型与出图演示"
            aria-label="播放机器视觉光源选型与出图演示视频"
          >
            <Image
              class="block aspect-[7/6] w-full object-cover"
              src={lightSourcePoster}
              alt="机器视觉光源条形光源选型界面"
              width={512}
              widths={[320, 512, 872]}
              sizes="(min-width: 768px) 640px, 88vw"
              format="webp"
              quality={82}
            />
            <span class="absolute inset-0 grid place-items-center bg-ink/20 transition group-hover:bg-ink/35">
              <span class="grid h-12 w-12 place-items-center rounded-full bg-white/95 shadow-md">
                <svg viewBox="0 0 24 24" class="ml-0.5 h-5 w-5 fill-brand-deep" aria-hidden="true">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </span>
            </span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <ContactSection />
  <CtaBand />
  <Lightbox />
</BaseLayout>
