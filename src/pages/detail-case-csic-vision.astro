---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Feature from '../components/Feature.astro';
import ContactSection from '../components/ContactSection.astro';
import CtaBand from '../components/CtaBand.astro';
---

<BaseLayout
  title="中船某研究所 AI 视觉应用案例 · 百六智数字科技"
  description="面向研究所实际场景的 AI 视觉识别与检测能力落地，提升作业自动化与质量管控水平。"
>
  <PageHero
    kicker="AI VISION"
    title="中船某研究所 AI 视觉应用"
    lede="面向研究所实际场景的 AI 视觉识别与检测能力落地，提升作业自动化与质量管控水平。"
  />

  <!-- 案例背景 -->
  <section id="intro" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead eyebrow="Background" title="案例背景" />
      <Feature
        desc="研究所在精密加工与检测场景中，尺寸、形位公差与表面质量的识别高度依赖人工，效率与一致性难以保障。"
        points={[
          '三大模块协同：多机械臂检测 + 视觉成像 + 视觉分析',
          '多机械臂检测模块：轨迹规划、全覆盖扫描、检测区域自动分配',
          '视觉成像模块：工业相机 + 光源组合成像',
          '视觉分析模块：图像预处理、特征提取、缺陷识别、与标准模型库比对',
        ]}
        img="/assets/media/docs/company-profile/elements/v4-p50-a.jpg"
        alt="中船某研究所 AI 视觉检测应用案例"
        caption="中船某研究所三模块协同 AI 视觉检测应用案例"
      />
    </div>
  </section>

  <!-- 方案要点 · 图文详解 -->
  <section id="solutions" class="bg-surface py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Solutions"
        title="方案要点 · 图文详解"
        desc="多机械臂检测、视觉成像与视觉分析三大模块协同作业。"
      />
      <div class="grid gap-10">
        <Feature
          sub="01 · 多机械臂检测模块"
          title="多台工业机械臂协同作业"
          desc="多台工业机械臂协同作业，负责轨迹规划与全覆盖扫描，实现检测区域自动分配，确保待检表面无遗漏。"
          points={['多台工业机械臂协同作业', '轨迹规划与全覆盖扫描', '检测区域自动分配']}
          img="/assets/media/docs/company-profile-pptx/media/img-ab01fc0d13a5.webp"
          alt="三模块协同 AI 视觉检测系统示意"
          caption="三模块协同 AI 视觉检测系统示意"
        />
        <Feature
          flip
          sub="02 · 视觉成像 + 视觉分析模块"
          title="从图像采集到缺陷识别"
          desc="视觉成像模块由工业相机与光源系统组合成像，完成表面图像采集与数据获取；视觉分析模块完成图像预处理与特征提取，实现缺陷识别与尺寸测量，并与标准模型数据库比对。"
          points={['工业相机 + 光源系统成像，完成表面图像采集与数据获取', '图像预处理与特征提取，缺陷识别与尺寸测量', '与标准模型数据库比对']}
        />
      </div>
    </div>
  </section>

  <ContactSection />
  <CtaBand
    sub="从实际场景出发，落地可量化的视觉识别价值。"
  >
    让 AI 视觉 <span class="text-gold-deep">重塑作业与质检</span>
  </CtaBand>
</BaseLayout>
