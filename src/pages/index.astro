---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import Card from '../components/Card.astro';
import ContactSection from '../components/ContactSection.astro';
import CtaBand from '../components/CtaBand.astro';
import SolutionsSection from '../components/SolutionsSection.astro';
import { segments, caseScenes, actions } from '../data/home';
---

<BaseLayout title="百六智数字科技 · 让每一家制造企业拥有专属「智慧大脑」">
  <Hero />

  <!-- 三大核心业务板块 -->
  <section id="scenes" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Core Business"
        title="三大核心业务场景"
        desc="助力中小型企业数字化转型三大场景 —— 研发设计制造一体化、智能化改造与 AI 智能体应用。"
      />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          segments.map((item) => (
            <Card
              img={item.img}
              alt={item.alt}
              idx={item.idx}
              title={item.title}
              points={item.points}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- 产品与解决方案（首页不展示产品卡列表，见产品和解决方案页） -->
  <SolutionsSection showProducts={false} />

  <!-- 客户应用案例 -->
  <section id="cases" class="bg-surface py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Case Studies"
        title="客户应用案例"
        desc="按产品应用场景分类，覆盖研发设计端 AI 与生产制造端 AI 两大核心业务。"
      />
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          caseScenes[0].cases.map((item) => (
            <Card
              img={item.img}
              alt={item.alt}
              big={item.big}
              title={item.title}
              desc={item.desc}
              metric={item.metric}
              href={item.href}
              class="bg-white"
            />
          ))
        }
      </div>
      <!-- 查看全部案例 -->
      <div class="mt-10 text-center">
        <a
          href="/cases/"
          class="inline-flex items-center rounded-full bg-brand px-8 py-3 text-[0.95rem] font-semibold text-white transition-colors hover:bg-brand-hover"
        >
          查看全部案例 →
        </a>
      </div>
    </div>
  </section>

  <!-- 立即行动 -->
  <section id="action" class="border-y border-ink/[0.08] bg-brand-soft py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead eyebrow="Get Started" title="立即行动" desc="从一个场景开始，0 风险体验 AI 与数字化转型价值。" />
      <div class="grid gap-6 md:grid-cols-2">
        {
          actions.map((item) => (
            <Card idx={item.idx} title={item.title} desc={item.desc} />
          ))
        }
      </div>
    </div>
  </section>

  <!-- 联系我们 -->
  <ContactSection
    note='"1+5+N" 战略布局：百六智数字科技（无锡）有限公司 · 哈尔滨公司 · 沈阳公司 · 合肥公司 · 深圳公司 —— 业务覆盖全国。'
  />

  <!-- CTA -->
  <CtaBand />
</BaseLayout>
