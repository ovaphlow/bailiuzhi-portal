---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Feature from '../components/Feature.astro';
import Figure from '../components/Figure.astro';
import Card from '../components/Card.astro';
import ContactSection from '../components/ContactSection.astro';
import CtaBand from '../components/CtaBand.astro';
---

<BaseLayout
  title="Fiz-Chat 智能工作平台 · 岗位 AI 员工 · 百六智数字科技"
  description="聊天界面即统一工作入口，AI 销售员、AI 客服、生产调度与质量检测智能体上岗，打通 MES/ERP/PLM/CRM —— 让事务处理从「天级」到「分钟级」，让每位员工拥有 AI 超级助手。"
>
  <PageHero
    kicker="FIZ-CHAT · 办公智能工作平台"
    title="Fiz-Chat 智能工作平台 · 岗位 AI 员工"
    lede="聊天界面即统一工作入口，AI 销售员、AI 客服、生产调度与质量检测智能体上岗，打通 MES/ERP/PLM/CRM —— 让事务处理从「天级」到「分钟级」，让每位员工拥有 AI 超级助手。"
  />

  <!-- 解决方案架构 · 四层设计 -->
  <section id="architecture" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Solution Architecture"
        title="解决方案架构 · 四层设计"
        desc="存量系统无损集成，不替换现有 ERP/MES；全链路留痕，审计合规。"
      />
      <div class="grid gap-10">
        <Feature
          sub="01 · 统一用户入口"
          title="聊天界面即工作入口"
          desc="自然语言对话式操作，「一句话办事」，员工无需在多个系统间来回切换。"
          points={['全媒体即时通讯，统一受理工作请求', '自然语言直达业务系统，降低使用门槛']}
          img="/assets/media/docs/company-profile/elements/v4-p27-a.jpg"
          alt="Fiz-Chat 对话即服务"
          caption="管理与办公侧 Fiz-Chat：对话即服务，提效决策"
        />
        <Feature
          flip
          sub="02 · 岗位 AI 员工层"
          title="四大岗位智能体随时在岗"
          desc="AI 销售员、AI 客服、生产调度智能体、质量检测智能体，以数字员工身份承担岗位事务。"
          points={['7×24 小时值守，秒级响应', '人机协作安全：5 秒人工接管熔断']}
          img="/assets/media/docs/company-profile/elements/v4-p15-a.jpg"
          alt="AI 智能体应用·三大场景"
          caption="AI 智能体应用场景"
        />
        <Feature
          sub="03 · Fiz-Chat 智能工作平台"
          title="即时通讯 + 大模型推理引擎 + 系统连接器"
          desc="融合即时通讯、大模型推理引擎与系统连接器三大底座能力，支撑岗位 AI 员工的感知、推理与执行。"
          points={['智能流程自动化，文档智能生成与处理', '企业知识精准问答，业务数据深度分析']}
        />
        <Feature
          flip
          sub="04 · 业务系统基石"
          title="打通 MES / ERP / PLM / CRM / HR / OA"
          desc="系统级业务直连，AI 员工的每一步操作都落到真实业务系统，形成执行闭环。"
          points={['存量系统无损集成，保护已有投资', '全链路留痕，满足审计合规要求']}
        />
      </div>
    </div>
  </section>

  <!-- 三大核心 AI 员工场景 -->
  <section id="employees" class="bg-surface py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="AI Employees"
        title="三大核心 AI 员工场景"
        desc="面向销售、客服与制造岗位的数字员工，覆盖企业对外服务与内部管控全链路。"
      />
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <Card
          idx="01 · AI 销售员"
          title="真机会话采集，自动跟进闭环"
          desc="真机会话采集、全渠道统一接入（官网 / 微信 / 电话 / IM），AI 智能秒级回复，自动跟进形成业务闭环。"
          points={['智能秒级回复，商机不遗漏', '人机协作安全：5 秒人工接管熔断']}
        />
        <Card
          idx="02 · AI 客服"
          title="全渠道接入，系统级业务直连"
          desc="自动读取企微 / 微信对话，智能抽取客户信息建档，智能决策路由，70%+ 常规咨询自动办结。"
          points={['系统级直连 ERP / MES，服务即办理', '7×24 小时值守，秒级回复']}
        />
      </div>
      <div class="mt-10">
        <Feature
          flip
          sub="03 · 制造岗位智能体"
          title="生产管控、质量追溯、供应链协同"
          desc="生产智能管控与智能决策路由；质量追溯闭环自动生成 8D / CAR 整改报告；供应链智控协同覆盖询价比价、交付跟踪与安全库存预警。"
          points={['质量追溯闭环：自动生成 8D / CAR 整改报告', '供应链智控：询价比价 / 交付跟踪 / 安全库存预警']}
          img="/assets/media/docs/company-profile/elements/v4-p36-a.jpg"
          alt="基于 Fiz-Chat 的协同智慧平台案例"
          caption="某大型电厂基于 Fiz-Chat 的协同智慧平台应用"
        />
      </div>
    </div>
  </section>

  <!-- 落地效果与标杆案例 -->
  <section id="results" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Results"
        title="落地效果与标杆案例"
        desc="四大落地效果，已在建材、物流、离散制造等行业标杆验证。"
      />
      <div class="grid gap-6 md:grid-cols-2">
        <Card
          idx="01 · 效率跃升"
          title="事务处理从天级到分钟级"
          desc="审批、查询、报表等日常事务由 AI 员工即时处理，整体事务响应进入分钟级。"
        />
        <Card
          idx="02 · 人效倍增"
          title="人均服务客户量成倍提升"
          desc="AI 员工承担重复性事务，让人的精力聚焦高价值决策与服务。"
        />
        <Card
          idx="03 · 实时洞察"
          title="从事后复盘到实时干预"
          desc="全量业务数据自动分析，异常主动预警，管理者实时掌握经营全貌。"
        />
        <Card
          idx="04 · 资产固化"
          title="岗位经验沉淀为数字化技能包"
          desc="岗位经验、工艺标准、优秀话术持续沉淀为数字化技能包，AI 员工能力随业务共同成长。"
        />
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <Figure
          img="/assets/media/docs/company-profile/elements/v4-p20-a.jpg"
          alt="让每位员工拥有 AI 超级助手"
          caption="核心价值主张：标准软件 × 私有化 AI × 企业知识库"
        />
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2">
        <Card
          idx="标杆 · 建材行业"
          title="AI 销售智能体"
          desc="7×24 小时全链路闭环，从线索响应到跟进转化全程自动。"
        />
        <Card
          idx="标杆 · 物流行业"
          title="AI 客服智能体"
          desc="91.7% 业务自动处理率，人均服务客户数提升 2 倍。"
        />
        <Card
          idx="标杆 · 离散制造"
          title="岗位智能体集群"
          desc="覆盖报关、PMC 排程、采购询价等岗位，效率提升数十倍。"
        />
        <Card
          idx="你的企业"
          title="从一个场景开始"
          desc="选择客服、销售或生产调度中的一个场景先行落地，快速验证岗位 AI 员工价值。"
        />
      </div>
    </div>
  </section>

  <!-- 安全合规 · 私有化部署 · 分阶段落地路径 -->
  <section id="deploy" class="bg-surface py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Security & Deployment"
        title="安全合规 · 私有化部署 · 分阶段落地"
        desc="数据主权安全、通讯与访问安全、审计合规三位一体，私有化部署保护企业数据资产；分阶段落地，小步快跑、快速见效。"
      />
      <div class="grid gap-6 md:grid-cols-3">
        <Card idx="01 · 数据主权安全" title="全私有化部署，数据不出域" desc="全系统支持纯私有化部署，数据完全内部流转，部门间严格隔离，敏感信息自动脱敏，满足军工、半导体行业数据安全的最高要求。" />
        <Card idx="02 · 通讯与访问安全" title="国密加密 · 防截屏水印" desc="国密 SM2/3/4 算法加密，支持防截屏与水印溯源、IP 白名单与设备管控，保障传输与访问安全。" />
        <Card idx="03 · 审计与合规" title="全操作留痕 · 可审计追溯" desc="全操作日志不可篡改，AI 指令全程留痕，完全满足等保 3.0 及行业监管审计要求，AI 交互与业务操作透明可控。" />
      </div>
      <div class="mt-10">
        <h3 class="text-lg font-semibold text-brand-deep">分阶段落地路径</h3>
        <div class="mt-4 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <div class="flex-1 rounded-xl border border-ink/[0.08] bg-white p-5">
            <div class="font-mono text-[0.72rem] tracking-[0.1em] text-gold-deep">01 · 基础通讯上线</div>
            <div class="mt-1 text-[0.8rem] font-semibold text-brand-deep">周期 0-1 周</div>
            <p class="mt-1 mb-0 text-[0.85rem] text-muted">部署 IM、音视频及基础 AI 能力，开箱即用，快速启动。</p>
          </div>
          <div class="flex-1 rounded-xl border border-ink/[0.08] bg-white p-5">
            <div class="font-mono text-[0.72rem] tracking-[0.1em] text-gold-deep">02 · 知识体系搭建</div>
            <div class="mt-1 text-[0.8rem] font-semibold text-brand-deep">周期 1-2 周</div>
            <p class="mt-1 mb-0 text-[0.85rem] text-muted">导入制度、产品文档，构建企业专属知识库，沉淀核心资产。</p>
          </div>
          <div class="flex-1 rounded-xl border border-ink/[0.08] bg-white p-5">
            <div class="font-mono text-[0.72rem] tracking-[0.1em] text-gold-deep">03 · 高频系统对接</div>
            <div class="mt-1 text-[0.8rem] font-semibold text-brand-deep">周期 1-2 个月</div>
            <p class="mt-1 mb-0 text-[0.85rem] text-muted">优先对接 OA、HR、CRM 等高频系统，打通日常办公场景。</p>
          </div>
          <div class="flex-1 rounded-xl border border-ink/[0.08] bg-white p-5">
            <div class="font-mono text-[0.72rem] tracking-[0.1em] text-gold-deep">04 · 核心业务打通</div>
            <div class="mt-1 text-[0.8rem] font-semibold text-brand-deep">周期 3-6 个月</div>
            <p class="mt-1 mb-0 text-[0.85rem] text-muted">接入 MES、ERP、PLM，落地核心岗位 AI 员工，赋能生产制造。</p>
          </div>
          <div class="flex-1 rounded-xl border border-ink/[0.08] bg-white p-5">
            <div class="font-mono text-[0.72rem] tracking-[0.1em] text-gold-deep">05 · 智能协作成熟</div>
            <div class="mt-1 text-[0.8rem] font-semibold text-brand-deep">周期 6-12 个月</div>
            <p class="mt-1 mb-0 text-[0.85rem] text-muted">跨系统复杂联动，AI 全面承接重复性工作，实现组织智能化。</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ContactSection />
  <CtaBand
    sub="从一个岗位场景开始，体验 Fiz-Chat 岗位 AI 员工带来的效率跃升。"
  >
    让每位员工都拥有 <span class="text-gold-deep">AI 超级助手</span>
  </CtaBand>
</BaseLayout>
