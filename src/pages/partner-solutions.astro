                        <span class="inline-flex items-center rounded-full bg-brand-soft px-3 py-1 text-[0.78rem] text-brand">
                          {c}
                        </span>
                      ))}
                    </div>
                  </div>

                  {/* 平台层「载荷可换」（BP P7）：与传感器分列，避免两组清单混成一片 */}
                  {p.payloads && (
                    <div class="mt-4">
                      <div class="text-[0.74rem] font-medium text-muted">可换载荷</div>
                      <div class="mt-2 flex flex-wrap gap-2">
                        {p.payloads.map((c) => (
                          <span class="inline-flex items-center rounded-full border border-gold/40 bg-gold-soft px-3 py-1 text-[0.78rem] text-gold-deep">
