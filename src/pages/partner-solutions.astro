    <!-- 精选案例（P11–P37）：01 大型民机外观检测为主案例，02 发电机巡检机器人 -->
    <section id="zonglian-cases" class="py-14 md:py-18">
      <div class="mx-auto max-w-300 px-6 lg:px-10">
        <SectionHead
          eyebrow="Cases"
          title="精选案例"
          desc="覆盖航空与能源电力场景 —— 大型民机外观检测，以及免抽转子的发电机巡检。"
        />
        <div class="grid gap-5">
          {
            zonglianCases.map((c, i) => (
              /* 案例卡统一骨架：媒体区 → 图注 → 深蓝标题牌（编号 / 标题 / 副标题 + 要点）→ 正文。
                 01 主案例的媒体区是「大图 + 右侧两张拼贴小图」，其余案例为单张通栏图。
                 标题牌必须整套复用，两张卡不要各写一套。 */
              <article class="overflow-hidden rounded-2xl border border-ink/[0.08] bg-white">
                <div class:list={['grid gap-2 p-2', c.featured && 'sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]']}>
                  <Image
                    class:list={['zoomable block w-full rounded-lg object-cover', c.featured ? 'aspect-3/2' : 'aspect-16/9']}
                    src={c.img}
                    alt={c.alt}
                    width={Math.min(1280, c.img.width)}
                    widths={caseWidths(c.img, [640, 960, 1280])}
                    sizes={c.featured ? '(min-width: 640px) 730px, 92vw' : '(min-width: 640px) 1100px, 92vw'}
                    format="webp"
                    quality={82}
                    data-lb-full={zonglianCaseFulls[i].img}
                    data-lb-caption={c.caption}
                  />
                  {c.featured && c.tiles && (
                    <div class="grid grid-cols-2 gap-2 overflow-hidden rounded-lg sm:grid-cols-1 sm:gap-0">
                      {c.tiles.map((t, ti) => (
                        <Image
                          class:list={[
                            'zoomable block aspect-3/2 w-full object-cover sm:rounded-none',
                            ti === 0 && 'sm:border-b-2 sm:border-white',
                          ]}
                          src={t.img}
                          alt={t.alt}
                          width={Math.min(640, t.img.width)}
                          widths={caseWidths(t.img, [320, 480, 640])}
                          sizes="(min-width: 640px) 365px, 46vw"
                          format="webp"
                          quality={82}
                          data-lb-full={zonglianCaseFulls[i].tiles[ti]}
                          data-lb-caption={t.caption}
                        />
                      ))}
                    </div>
                  )}
                </div>

                {c.caption && (
                  <p class="mx-2 mt-3 mb-0 text-[0.78rem] leading-relaxed text-muted">
                    {c.caption}
                    {c.tiles?.map((t) => `　|　${t.caption}`)}
                  </p>
                )}

                <div class="mx-2 mt-3 flex flex-wrap items-center gap-x-6 gap-y-3 rounded-xl bg-brand-deep px-5 py-4">
                  <div class="min-w-0">
                    <div class="font-mono text-[0.7rem] tracking-[0.14em] text-gold">{c.no}</div>
                    <h3 class="mt-1 mb-0 text-[1.2rem] font-semibold text-white">{c.title}</h3>
                    <p class="mt-1 mb-0 text-[0.84rem] text-white/65">{c.subtitle}</p>
                  </div>
                  <div class="ml-auto flex flex-wrap items-center gap-2">
                    <span class="font-mono text-[0.66rem] tracking-[0.14em] text-white/45">
                      {c.specsLabel ?? '应用场景'}
                    </span>
                    {c.specs.map((s) => (
                      <span class="inline-flex items-center rounded-full bg-white/[0.12] px-3 py-1 text-[0.78rem] text-white/90">
                        {s}
                      </span>
                    ))}
                  </div>
                </div>

                <p class="m-0 px-6 pt-4 pb-6 text-[0.9rem] leading-relaxed text-muted lg:px-8">{c.desc}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 演示视频（置于纵涟区块最下方；点击由 Lightbox 播放） -->
    <section id="zonglian-videos" class="bg-surface py-14 md:py-18">
      <div class="mx-auto max-w-300 px-6 lg:px-10">
        <SectionHead
