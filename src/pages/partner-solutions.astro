                    src={c.logo}
                    alt={`${c.name}（${c.en}）`}
                    width={Math.min(c.logo.width, 480)}
                    widths={srcWidths(c.logo, [160, 240, 320, 420, 480, 640, 960])}
                    sizes="(min-width: 1024px) 340px, (min-width: 640px) 45vw, 88vw"
                    format="png"
                  />
                </span>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 mb-0 text-center text-[0.82rem] text-muted">主要客户（部分），排名不分先后</p>
      </div>
    </section>

    <!-- 应用场景价值矩阵（P3） -->
    <section id="zonglian-markets" class="py-14 md:py-18">
      <div class="mx-auto max-w-300 px-6 lg:px-10">
        <SectionHead
          eyebrow="Market"
          title="应用场景价值矩阵"
          desc="从核心支柱产业到技术高地，逐层切入。"
        />
        {/*
          层级卡整行通栏、各自按内容取高（并排等高时，短的那张卡内部会空出大片空白）。
          两个层级在原给材料（公司简介 P3）里是同级别、并列的三个层级，标题条因此必须完全同款：
          蓝底白字，左侧「序号 + 层级名」，右侧场景数 —— 除层级名外不放任何第二种文字。
          「技术高地」层的条目取自 PPT P7（两条尖刀场景），P7 的页副标题与平台层／底座层
          另作卡内子块，见下方「子块标题」注释。
          底纹压到 0.05，避免竖线被误读成内容要对齐的栅格。
        */}
        <div class="grid gap-5">
          {
            markets.map((tier, ti) => (
              <article class="overflow-hidden rounded-2xl border border-ink/[0.08] bg-white">
                <header class="relative overflow-hidden bg-[linear-gradient(115deg,#1a4a8c_0%,#245aa6_58%,#1a4a8c_100%)] px-6 py-5 md:px-8">
                  <span
                    class="pointer-events-none absolute inset-0 opacity-[0.05] [background-image:repeating-linear-gradient(90deg,rgba(255,255,255,0.7)_0,rgba(255,255,255,0.7)_1px,transparent_1px,transparent_44px)]"
                    aria-hidden="true"
                  />
                  <div class="relative flex flex-wrap items-baseline gap-x-4 gap-y-1.5">
                    <span class="font-mono text-[0.7rem] tracking-[0.2em] text-gold">
                      {String(ti + 1).padStart(2, '0')}
                    </span>
                    <h3 class="m-0 text-[1.15rem] leading-tight font-semibold tracking-tight text-white">
                      {tier.tag}
                    </h3>
                    <span class="ml-auto font-mono text-[0.7rem] text-white/55">
                      {tier.items.length} 个场景
                    </span>
                  </div>
                </header>

                <div class="px-6 py-6 md:px-8 md:py-7">
                  {/*
                    子块标题（PPT P7 的页副标题）：「一平台 · 两尖刀 · 一底座」管的是这一整块 ——
                    两条尖刀场景、平台层、底座层，所以位置照 P7 的顺序必须在**内容之上**
                    （P7 页面自上而下：标题条 → 尖刀①② → 平台层 → 底座层）。
                    它不进顶部层级标题条：P3 里每个层级都只有一条单行标题带，进了就与「核心市场」那层不齐。
                    标题只用 P7 原词，不加英文 kicker（中文标题已把话说尽，英文格无信息量、材料里也没这个词）。
                    发丝线只用来把这行与下面的条目分开。
                  */}
                  {tier.head && (
                    <div class="mb-6 flex flex-wrap items-baseline gap-3">
                      <h4 class="m-0 text-[1.05rem] font-semibold text-brand-deep">{tier.head.label}</h4>
                      <span class="hidden h-[1px] flex-1 bg-ink/[0.08] sm:block" />
                    </div>
                  )}

                  {/* 条目：3 条以上铺 3 列，2 条铺 2 列；序号沿用全站的等宽小字风格 */}
                  <div
                    class:list={[
                      'grid gap-5',
                      tier.items.length >= 3 ? 'sm:grid-cols-2 lg:grid-cols-3' : 'sm:grid-cols-2',
                    ]}
                  >
                    {tier.items.map((it, ii) => (
                      <div>
                        {/* 序号 + 名称 + 状态标签（如「样机在研」）：未交付的场景必须带状态，避免被读成已落地 */}
                        <div class="flex flex-wrap items-baseline gap-x-2.5 gap-y-1.5">
                          <span class="font-mono text-[0.7rem] tracking-[0.16em] text-gold-deep">
                            {String(ii + 1).padStart(2, '0')}
                          </span>
                          <h4 class="m-0 text-[1rem] font-semibold text-brand-deep">{it.name}</h4>
                          {it.status && (
                            <span class="inline-flex items-center rounded-full bg-gold-soft px-2.5 py-0.5 text-[0.72rem] font-medium text-gold-deep">
                              {it.status}
                            </span>
                          )}
                        </div>
                        <p class="mt-2 mb-0 text-pretty text-[0.86rem] leading-relaxed text-muted">
                          {it.scene}
                        </p>
                        <p
                          class:list={[
                            'mt-2.5 mb-0 text-pretty text-[0.86rem] leading-relaxed text-muted',
                            /* 三列铺开时列宽窄，某一条会折两行；统一预留两行高度，三列底部才齐 */
                            tier.items.length >= 3 && 'lg:min-h-[2.85rem]',
                          ]}
                        >
                          <span class="font-semibold text-brand">{it.value}</span>
                          <span class="mx-1.5">→</span>
                          {it.effect}
                        </p>
                      </div>
                    ))}
                  </div>

                  {/*
                    承托层：顺序照 P7 —— 两条尖刀在上，平台层、底座层在其下逐级承托。
                    P7 用的是两个「直接连接符」分别从两条尖刀指向平台层、再一指到底座层，
                    这里照做：尖刀→平台层是两条（各在其所属列居中），平台层→底座层是一条。
                    窄屏条目只有一列、箭头只能排在中间，第二条重复，故窄屏只留一条。
                    连接符用品牌蓝而非默认灰，与标题条同色系；纯装饰、无交互。
                  */}
                  {tier.head && (
                    <div class="mt-6">
                      <div class="grid gap-4 sm:grid-cols-2 sm:gap-5" aria-hidden="true">
                        <div class="flex flex-col items-center text-brand/30">
                          <span class="h-4 w-[2px] bg-current" />
                          <svg viewBox="0 0 12 8" class="h-2.5 w-3.5 fill-current">
                            <path d="M6 8 0 0h12z" />
                          </svg>
                        </div>
                        <div class="flex flex-col items-center text-brand/30 max-sm:hidden">
                          <span class="h-4 w-[2px] bg-current" />
                          <svg viewBox="0 0 12 8" class="h-2.5 w-3.5 fill-current">
                            <path d="M6 8 0 0h12z" />
                          </svg>
                        </div>
                      </div>

                      <div class="grid gap-4">
                        {tier.head.layers.map((layer, li) => (
                          <div>
                            {li > 0 && (
                              <div class="flex flex-col items-center text-brand/30" aria-hidden="true">
                                <span class="h-4 w-[2px] bg-current" />
                                <svg viewBox="0 0 12 8" class="h-2.5 w-3.5 fill-current">
                                  <path d="M6 8 0 0h12z" />
                                </svg>
                              </div>
                            )}
                            {/* 层名自带「平台层／底座层」字样，不再配圆形文字徽标（徽标与层名重复）；
                                浅蓝底表示「承托」层级，与标题条同色系 */}
                            <div class="rounded-xl border border-brand/15 bg-brand-soft px-5 py-4">
                              <div class="text-[0.92rem] font-semibold text-brand-deep">{layer.name}</div>
                              <p class="mt-1.5 mb-0 text-pretty text-[0.83rem] leading-relaxed text-muted">
                                {layer.desc}
                              </p>
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 关键技术能力（P9） -->
    <section id="zonglian-capabilities" class="py-14 md:py-18">
      <div class="mx-auto max-w-300 px-6 lg:px-10">
        <SectionHead
          eyebrow="Capabilities"
          title="关键技术能力"
          desc="装备、感知、运维、平台与远程支持的完整技术栈。"
