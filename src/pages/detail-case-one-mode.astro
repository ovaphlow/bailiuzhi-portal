---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import OneModePipeline from '../components/OneModePipeline.astro';
import ContactSection from '../components/ContactSection.astro';
import CtaBand from '../components/CtaBand.astro';
import Lightbox from '../components/Lightbox.astro';
import { Image, getImage } from 'astro:assets';
import oneModePosterA from '../assets/media/review/one-mode/one-mode-a-poster.png';
import oneModePosterB from '../assets/media/review/one-mode/one-mode-b-poster.png';
import engineHead from '../assets/media/review/one-mode/engine-head.jpg';

/** 量化结果，依据《公司简介 4.0》P45 的两处标注与总体结论 */
const kpis = [
  { value: '1 周 → 4 小时', label: 'CAS 自动标注专业操作时间' },
  { value: '2 周 → 1 小时', label: '测针配置与测点生成' },
  { value: '提效 60%', label: '测量准备时间总体' },
];

/**
 * 演示视频来自《非标设计自动化系统方案V3.0.pptx》第 34 页的两段内嵌视频
 * （原 media7.mp4 / media8.mp4）。视频放 public/，astro:assets 不处理视频。
 */
const V = '/assets/media/review/one-mode';

const demos = [
  {
    name: '应用效果案例 · 汽车发动机缸体',
    desc: '数量 300+，资源为机型与探针库，按企业规则与知识订制。',
    poster: oneModePosterA,
    video: `${V}/media7.mp4`,
    caption: '复杂零部件一模到底：应用效果案例（汽车发动机缸体，数量 300+）',
    alt: '应用效果案例：汽车发动机缸体，数量 300+',
  },
  {
    name: 'MBD 自动标注实操',
    desc: '在三维模型中自动生成尺寸标注，并按基准规则选择标注对象。',
    poster: oneModePosterB,
    video: `${V}/media8.mp4`,
    caption: '复杂零部件一模到底：发动机缸体 MBD 自动标注实操',
    alt: '发动机缸体 MBD 自动标注实操界面',
  },
];

/** 灯箱播放前的封面大图（约 1024px，点击播放时才请求） */
const posterSrcs = await Promise.all(
  demos.map(
    async (d) =>
      (await getImage({ src: d.poster, width: Math.min(1024, d.poster.width), format: 'webp', quality: 82 })).src
  )
);

/**
 * 发动机缸盖实拍图，取自《非标设计自动化系统方案V3.0.pptx》第 34 页（原 image143.jpeg，
 * 3713×2475）。缸盖架在三坐标测量机上、测头正探向零件，用于直观体现零件复杂度。
 * 点击可放大，故另生成一张 1920px 的大图供灯箱使用。
 */
const engineHeadFull = (await getImage({ src: engineHead, width: 1920, format: 'webp', quality: 82 })).src;
---

<BaseLayout
  title="复杂零部件一模到底的设计、检测一体化应用案例 · 百六智数字科技"
  description="以 MBD 信息模型直驱设计、加工与检测全链路：设计制造一体化属性库与结构化加工/检测工艺库支撑，自动标注、检测计划、NC 加工程序与三坐标测量程序自动生成。"
>
  <PageHero
    kicker="ONE-MODE MBD"
    title="复杂零部件实现一模到底的设计、检测一体化应用案例"
    lede="以 MBD 信息模型直驱设计、加工与检测全链路：设计制造一体化属性库与结构化加工／检测工艺库支撑，自动标注、检测计划、NC 加工程序与三坐标测量程序自动生成。"
  />

  <section id="part" class="bg-surface py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Part"
        title="复杂零部件 · 发动机缸盖"
        desc="以发动机缸盖为代表的复杂零部件，形状复杂、精度要求高、涉及规范多；从设计到检测，由 MBD 信息模型直驱全链。"
      />
      <figure class="m-0 overflow-hidden rounded-xl border border-ink/[0.08] bg-white">
        <Image
          class="zoomable block aspect-[3/2] w-full object-cover"
          src={engineHead}
          alt="发动机缸盖架在三坐标测量机上，测头正探向零件"
          width={1440}
          widths={[640, 960, 1440, 1920]}
          sizes="(min-width: 768px) 1120px, 92vw"
          format="webp"
          quality={82}
          data-lb-full={engineHeadFull}
        />
        <figcaption class="m-0 px-5 py-3.5 text-[0.85rem] text-muted">
          发动机缸盖 · 三坐标测量：测针自动配置与测点生成，测量准备时间由 2 周缩短至 1 小时。
        </figcaption>
      </figure>
    </div>
  </section>

  <section id="overview" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Overview"
        title="一模到底的量化结果"
        desc="从 UG NX 模型到三坐标测量程序，一个模型贯穿设计与检测；六项支撑库经 MBD 信息模型直驱全链。"
      />
      <div class="grid gap-6 rounded-xl border border-brand/10 bg-brand-soft p-6 sm:grid-cols-3 md:p-8">
        {
          kpis.map((k) => (
            <div class="text-center">
              <div class="text-[clamp(1.25rem,2.3vw,1.7rem)] leading-tight font-semibold text-brand-deep">
                {k.value}
              </div>
              <div class="mt-2 text-[0.86rem] text-muted">{k.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="pipeline" class="bg-surface py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Pipeline"
        title="一模到底 · 全链路自动化"
        desc="六项支撑库经 MBD 信息模型直驱四个环节，并派生检测计划生成与 NC 加工程序自动生成。"
      />
      <OneModePipeline />
      <p class="mt-3 mb-0 text-center text-[0.8rem] text-muted">
        设计规范库、设计制造一体化属性库、要素命名规则、自动匹配属性、结构化加工／检测工艺库、检测工艺／资源库共同支撑；末端输出检测计划、NC 加工程序与三坐标测量程序。
      </p>
    </div>
  </section>

  <section id="demo" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Demo"
        title="应用效果演示"
        desc="从应用效果案例到 MBD 自动标注实操。点击封面播放演示视频。"
      />
      <div class="grid gap-5 md:grid-cols-2">
        {
          demos.map((d, i) => (
            <div class="flex flex-col rounded-xl border border-ink/[0.08] bg-white p-5">
              <h3 class="m-0 text-base font-semibold text-brand-deep">{d.name}</h3>
              <p class="mt-1.5 mb-0 text-[0.85rem] text-muted">{d.desc}</p>

              <button
                type="button"
                class="group relative mt-4 block w-full cursor-pointer overflow-hidden rounded-lg border border-ink/[0.08] bg-ink/5 p-0"
                data-lb-video={d.video}
                data-lb-poster={posterSrcs[i]}
                data-lb-caption={d.caption}
                aria-label={`播放${d.name}演示视频`}
              >
                <Image
                  class="block aspect-video w-full object-cover"
                  src={d.poster}
                  alt={d.alt}
                  width={512}
                  widths={[320, 512, 768]}
                  sizes="(min-width: 768px) 510px, 88vw"
                  format="webp"
                  quality={82}
                />
                <span class="absolute inset-0 grid place-items-center bg-ink/20 transition group-hover:bg-ink/35">
                  <span class="grid h-12 w-12 place-items-center rounded-full bg-white/95 shadow-md">
                    <svg viewBox="0 0 24 24" class="ml-0.5 h-5 w-5 fill-brand-deep" aria-hidden="true">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                </span>
              </button>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ContactSection />
  <CtaBand />
  <Lightbox />
</BaseLayout>
