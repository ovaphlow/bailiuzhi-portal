---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import OneModePipeline from '../components/OneModePipeline.astro';
import ContactSection from '../components/ContactSection.astro';
import CtaBand from '../components/CtaBand.astro';

/** 量化结果，依据《公司简介 4.0》P45 的两处标注与总体结论 */
const kpis = [
  { value: '1 周 → 4 小时', label: 'CAS 自动标注专业操作时间' },
  { value: '2 周 → 1 小时', label: '测针配置与测点生成' },
  { value: '提效 60%', label: '测量准备时间总体' },
];
---

<BaseLayout
  title="复杂零部件一模到底的设计、检测一体化应用案例 · 百六智数字科技"
  description="以 MBD 信息模型直驱设计、加工与检测全链路：设计制造一体化属性库与结构化加工/检测工艺库支撑，自动标注、检测计划、NC 加工程序与三坐标测量程序自动生成。"
>
  <PageHero
    kicker="ONE-MODE MBD"
    title="复杂零部件实现一模到底的设计、检测一体化应用案例"
    lede="以 MBD 信息模型直驱设计、加工与检测全链路：设计制造一体化属性库与结构化加工／检测工艺库支撑，自动标注、检测计划、NC 加工程序与三坐标测量程序自动生成。"
  />

  <section id="overview" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Overview"
        title="一模到底的量化结果"
        desc="从 UG NX 模型到三坐标测量程序，一个模型贯穿设计与检测；六项支撑库经 MBD 信息模型直驱全链。"
      />
      <div class="grid gap-6 rounded-xl border border-brand/10 bg-brand-soft p-6 sm:grid-cols-3 md:p-8">
        {
          kpis.map((k) => (
            <div class="text-center">
              <div class="text-[clamp(1.25rem,2.3vw,1.7rem)] leading-tight font-semibold text-brand-deep">
                {k.value}
              </div>
              <div class="mt-2 text-[0.86rem] text-muted">{k.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="pipeline" class="bg-surface py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Pipeline"
        title="一模到底 · 全链路自动化"
        desc="六项支撑库经 MBD 信息模型直驱四个环节，并派生检测计划生成与 NC 加工程序自动生成。"
      />
      <OneModePipeline />
      <p class="mt-3 mb-0 text-center text-[0.8rem] text-muted">
        设计规范库、设计制造一体化属性库、要素命名规则、自动匹配属性、结构化加工／检测工艺库、检测工艺／资源库共同支撑；末端输出检测计划、NC 加工程序与三坐标测量程序。
      </p>
    </div>
  </section>

  <ContactSection />
  <CtaBand />
</BaseLayout>
