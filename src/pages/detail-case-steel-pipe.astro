---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import SteelPipeFlow from '../components/SteelPipeFlow.astro';
import ContactSection from '../components/ContactSection.astro';
import CtaBand from '../components/CtaBand.astro';

/** 案例背景要点：[引导词, 说明]，依据《公司简介 4.0》P48 案例页的痛点陈述 */
const backgroundPoints: [string, string][] = [
  ['原材料损耗严重', '年度物料浪费超千万元'],
  ['库存周转滞缓', '仓储占用与资金积压成本居高不下'],
  ['订单物料长期呆滞', '排产无法优先消化库存'],
  ['计划依赖人工经验', '用料、交期与库存难以同时兼顾'],
];

/** 量化结果，依据《公司简介 4.0》P48 案例页原文 */
const kpis = [
  { value: '超千万元', label: '改造前年度物料浪费' },
  { value: '800 万元/年', label: '原材料成本节省' },
  { value: '20%', label: '订单扩容' },
];
---

<BaseLayout
  title="无缝钢管 AI 排程应用案例 · 百六智数字科技"
  description="破解原材料损耗严重、库存周转滞缓、订单物料长期呆滞难题 —— 每年节省原材料成本 800 万元，订单扩容 20%。"
>
  <PageHero
    kicker="STEEL PIPE APS · AI 智能排产 | 降本增效 | 库存优化"
    title="无缝钢管 AI 排程应用案例"
    lede="破解原材料损耗严重、库存周转滞缓、订单物料长期呆滞难题 —— 每年节省原材料成本 800 万元，订单扩容 20%。"
  />

  <section id="pain" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead eyebrow="Background" title="案例背景" />
      <div class="rounded-xl border border-brand/10 bg-brand-soft p-6 md:p-8">
        <p
          class="m-0 max-w-240 text-[1.05rem] leading-relaxed font-medium text-brand-deep md:text-[1.18rem]"
        >
          无缝钢管生产物料成本高、计划靠人工经验，浪费与呆滞长期并存。
        </p>
        <ul class="mt-6 mb-0 grid list-none gap-x-10 gap-y-4 p-0 md:grid-cols-2">
          {
            backgroundPoints.map(([label, rest]) => (
              <li class="relative pl-6 text-[1rem] leading-relaxed text-ink before:absolute before:left-0 before:top-[0.5em] before:h-2.5 before:w-2.5 before:rounded-sm before:bg-gold before:content-['']">
                <strong class="font-semibold text-brand-deep">{label}：</strong>
                {rest}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section id="pipeline" class="bg-surface py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Pipeline"
        title="AI 排程的三条主线"
        desc="排程同时面对原材料、订单与库存三方面约束，三条主线各自对应一项改造目标。"
      />
      <SteelPipeFlow />
    </div>
  </section>

  <section id="value" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Value"
        title="客户价值收益"
        desc="从每年超千万元的物料浪费，到 800 万元成本节省与 20% 订单扩容。"
      />
      <div class="grid gap-6 rounded-xl border border-brand/10 bg-brand-soft p-6 sm:grid-cols-3 md:p-8">
        {
          kpis.map((k) => (
            <div class="text-center">
              <div class="text-[clamp(1.25rem,2.3vw,1.7rem)] leading-tight font-semibold text-brand-deep">
                {k.value}
              </div>
              <div class="mt-2 text-[0.86rem] text-muted">{k.label}</div>
            </div>
          ))
        }
      </div>
      <p class="mt-3 mb-0 text-center text-[0.8rem] text-muted">
        工序优化减少换模与质检、订单智能合并排料提高切割用料利用率、排产优先消化库存，三条主线同步改善成本与交付。
      </p>
    </div>
  </section>

  <ContactSection />
  <CtaBand />
</BaseLayout>
