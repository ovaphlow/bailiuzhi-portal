---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import BearingMbdDiagram from '../components/BearingMbdDiagram.astro';
import Lightbox from '../components/Lightbox.astro';
import ContactSection from '../components/ContactSection.astro';
import CtaBand from '../components/CtaBand.astro';

/** 案例背景要点：[冒号前的引导词, 说明] */
const backgroundPoints: [string, string][] = [
  ['参数化结构设计', '轴承零部件参数化建模，总耗时 5 分钟/个'],
  ['三维自动标注', 'MBD 模型自动生成，关节轴承组件尺寸链分析'],
  ['检测表单自动生成', '符合最新国标'],
  ['老国标降版图纸自动生成', '对接现有能力；加工工艺自动生成'],
];
---

<BaseLayout
  title="轴承行业 MBD 设计检测一体化案例 · 百六智数字科技"
  description="基于 MBD 的轴承设计与检测一体化方案，实现三维标注、尺寸链分析与检测计划自动生成，标准件设计单件 5 分钟。"
>
  <PageHero
    kicker="BEARING MBD"
    title="轴承行业 MBD 设计检测一体化"
    lede="基于 MBD 的轴承设计与检测一体化方案，实现三维标注、尺寸链分析与检测计划自动生成，标准件设计单件 5 分钟。"
  />

  <section id="intro" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead eyebrow="Background" title="案例背景" />
      <div class="rounded-xl border border-brand/10 bg-brand-soft p-6 md:p-8">
        <p class="m-0 max-w-240 text-[1.05rem] leading-relaxed font-medium text-brand-deep md:text-[1.18rem]">
          轴承标准件系列多、改型频繁，参数化建模与检测编程重复性高，交付周期与质量一致性难以兼顾。
        </p>
        <ul class="mt-6 mb-0 grid list-none gap-x-10 gap-y-4 p-0 md:grid-cols-2">
          {
            backgroundPoints.map(([label, rest]) => (
              <li class="relative pl-6 text-[1rem] leading-relaxed text-ink before:absolute before:left-0 before:top-[0.5em] before:h-2.5 before:w-2.5 before:rounded-sm before:bg-gold before:content-['']">
                <strong class="font-semibold text-brand-deep">{label}：</strong>
                {rest}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- 对应 PPT 第 2 页「轴承标准件设计、检测一体化的解决方案」，按原始版式复刻 -->
  <section id="solutions" class="bg-surface py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Solutions"
        title="轴承标准件设计、检测一体化的解决方案"
        desc=""
      />
      <BearingMbdDiagram />
    </div>
  </section>

  <ContactSection />
  <CtaBand />
  <Lightbox />
</BaseLayout>
