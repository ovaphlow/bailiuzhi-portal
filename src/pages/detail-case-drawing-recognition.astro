---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Card from '../components/Card.astro';
import DrawingRecognitionPipeline from '../components/DrawingRecognitionPipeline.astro';
import DrawingRecognitionSheet from '../components/DrawingRecognitionSheet.astro';
import ContactSection from '../components/ContactSection.astro';
import CtaBand from '../components/CtaBand.astro';

/**
 * 内容依据根目录《二维图纸自动识别软件介绍1.0.pptx》与《公司简介 4.0》P46。
 */
const kpis = [
  { value: '95% 以上', label: '识别解析准确率' },
  { value: '5 种', label: '图纸输入格式' },
  { value: '5 步', label: '识别到测量直驱链路' },
];

/** slide2 主要功能 */
const features = [
  {
    idx: '01 · 多格式输入',
    title: '支持 PDF、JPG、PNG、DWG、DXF 格式导入',
    desc: '多元格式图纸直接导入，无需转换；同时支持批量输入、旋转图纸、扫描与拍照图纸，以及超大幅图纸。',
  },
  {
    idx: '02 · 复杂标注自动识别',
    title: '多类型复杂标注自动识别',
    desc: '包含尺寸公差、形位公差、粗糙度、基准和技术要求等，并对识别结果进行气泡号标注。',
  },
  {
    idx: '03 · 结果规范导出',
    title: '识别结果快速、规范导出',
    desc: '支持气泡图（pdf）、检测计划表（excel）的生成与导出，并可直驱工艺、工时与报价（excel）。',
  },
];

/** slide6-8 三个智能算法 */
const algos = [
  {
    idx: '工艺信息分类',
    desc: '通过神经网络对不同工艺信息的特征识别，并结合 OCR 文本识别等功能对不同的工艺信息区分处理。',
  },
  {
    idx: '同视图分类',
    desc: '通过整理公差形式和引线关联轮廓获得视图范围，关联同视图的所有标注。',
  },
  {
    idx: '轮廓提取',
    desc: '通过线卷积神经网络提取不同标注形式的引线关联轮廓。',
  },
];

/** slide9-12 个性化检测表单定制 */
const customs = [
  { unit: '某机加企业', items: '特殊特性识别，匹配检测工艺及设备' },
  { unit: '某航空单位', items: '生成首件检验清单，技术要求提取，特性符号匹配' },
  { unit: '某 3C 电子企业', items: '气泡号识别，标注图幅定位分区识别' },
  { unit: '某风电企业', items: '超大图幅识别，复杂形位公差表单生成' },
];
---

<BaseLayout
  title="二维图纸智能识别与测量直驱应用案例 · 百六智数字科技"
  description="图纸智能识别、智能解析、工艺智能匹配、模型智能重构、数智直驱测量五步链路，自动产出测量任务、工艺、重构模型与检测表单，解析准确率 95% 以上。"
>
  <PageHero
    kicker="DRAWING RECOGNITION"
    title="二维图纸智能识别与测量直驱"
    lede="图纸智能识别 → 图纸智能解析 → 工艺智能匹配 → 模型智能重构 → 数智直驱测量，五步链路自动产出测量任务、工艺、重构模型与检测表单。"
  />

  <section id="overview" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Overview"
        title="从二维图纸到测量直驱"
        desc="多元格式图纸直接导入，自动识别图纸上的各类标注与要求，输出可用的测量任务与检测表单。"
      />
      <div class="grid gap-6 rounded-xl border border-brand/10 bg-brand-soft p-6 sm:grid-cols-3 md:p-8">
        {
          kpis.map((k) => (
            <div class="text-center">
              <div class="text-[clamp(1.4rem,2.6vw,1.9rem)] leading-tight font-semibold text-brand-deep">
                {k.value}
              </div>
              <div class="mt-2 text-[0.86rem] text-muted">{k.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="pipeline" class="bg-surface py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Pipeline"
        title="五步链路 · 从图纸到测量"
        desc="二维图纸导入后，经识别、解析、工艺匹配与模型重构，直接驱动测量环节。"
      />
      <DrawingRecognitionPipeline />
    </div>
  </section>

  <section id="capability" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead eyebrow="Capability" title="主要功能" desc="输入、识别、导出三个环节的能力。" />
      <div class="grid gap-6 md:grid-cols-3">
        {features.map((f) => <Card idx={f.idx} title={f.title} desc={f.desc} />)}
      </div>
    </div>
  </section>

  <section id="recognition" class="bg-surface py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Recognition"
        title="能识别什么"
        desc="尺寸公差、形位公差、表面结构、技术要求与明细表、标注线与箭头、零件轮廓、气泡号与基准均可识别。"
      />
      <DrawingRecognitionSheet />
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {algos.map((a) => <Card idx={a.idx} title="智能算法" desc={a.desc} />)}
      </div>
    </div>
  </section>

  <section id="custom" class="py-14 md:py-18">
    <div class="mx-auto max-w-300 px-6 lg:px-10">
      <SectionHead
        eyebrow="Customization"
        title="个性化检测表单定制"
        desc="面向不同行业客户的输出定制，已落地四类场景。"
      />
      <div class="grid gap-6 md:grid-cols-2">
        {
          customs.map((c) => (
            <div class="rounded-xl border border-ink/[0.08] bg-surface p-6">
              <div class="font-mono text-[0.75rem] tracking-[0.1em] text-gold-deep">{c.unit}</div>
              <p class="mt-2.5 mb-0 text-[0.95rem] text-muted">{c.items}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <ContactSection />
  <CtaBand />
</BaseLayout>
